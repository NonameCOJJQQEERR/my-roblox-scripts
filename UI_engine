        local nextRotation = sectionSelf.Opened and 0 or -90
        TweenService:Create(arrow, TweenInfo.new(0.2), { Rotation = nextRotation }):Play()
        
        local divider = sectionSelf.Container:FindFirstChild("HeaderDivider")
        if divider then
            divider.Visible = sectionSelf.Opened
