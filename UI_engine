            BorderSizePixel = 0,
        }, {
            Create("UIListLayout", {
                Padding = UDim.new(0, 4),
                SortOrder = Enum.SortOrder.LayoutOrder
            })
        })
    })

    local listObject = {}
    listObject.Frame = listCard
    listObject._Card = listCard

    function listObject:Update(newItems)
        for _, child in ipairs(listCard.Container:GetChildren()) do
            if child:IsA("Frame") then
                child:Destroy()
            end
        end

        local count = 0
        for i, item in ipairs(newItems) do
            count = count + 1
            Create("Frame", {
                Name = "Item_" .. tostring(i),
                Size = UDim2.new(1, 0, 0, 16),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                LayoutOrder = i,
                Parent = listCard.Container
            }, {
                Create("TextLabel", {
                    Name = "NameLabel",
                    Text = item.name,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 10,
                    TextColor3 = window.Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Size = UDim2.new(0.4, 0, 1, 0),
                    BackgroundTransparency = 1
                }),
                Create("TextLabel", {
                    Name = "ValueLabel",
                    Text = item.value,
                    Font = Enum.Font.Gotham,
                    TextSize = 10,
                    TextColor3 = window.Theme.MutedText,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Size = UDim2.new(0.6, 0, 1, 0),
                    Position = UDim2.new(0.4, 0, 0, 0),
                    BackgroundTransparency = 1
                })
            })
        end

        listCard.Size = UDim2.new(1, 0, 0, 32 + count * 20)
        listCard.Container.Size = UDim2.new(1, -16, 0, count * 20)
    end

    if list then
        listObject:Update(list)
    end

    return listObject
end

