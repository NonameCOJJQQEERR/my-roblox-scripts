-- Resolve which icon a section header should render.
-- icon == false  -> legacy accent dot (opt-out)
-- icon == string -> that icon
-- icon == nil    -> inferred from the section name, else "layers"
local function ResolveSectionIcon(name, icon)
    if icon == false then return nil end
    if type(icon) == "string" and icon ~= "" then return icon end
    local lowered = string.lower(tostring(name or ""))
    for keyword, iconName in pairs(SectionIconMap) do
        if string.find(lowered, keyword, 1, true) and LucideIcons[iconName] then
            return iconName
        end
    end
    return "layers"
end

