-- Label element
function Tab:CreateLabel(text)
    local labelCard = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = self.Page
    }, {
        Create("TextLabel", {
            Name = "LabelText",
