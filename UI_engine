                Name = "Knob",
                Size = UDim2.new(0, 11, 0, 11),
                Position = UDim2.new(0, 2, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = Color3.fromRGB(240, 240, 245),
                BorderSizePixel = 0,
                ZIndex = 4
            }, {
                Create("UICorner", { CornerRadius = UDim.new(0.5, 0) })
            })
        })
    })

    local textBtn = toggleCard:FindFirstChildOfClass("TextButton")
    local track = toggleCard.Track
    local knob = track.Knob

    local function updateToggle(animate)
        local timeSec = animate and 0.2 or 0
        local nextColor = active and window.Accent or window.Theme.InputBackground
        local nextKnobPos = active and UDim2.new(1, -13, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)

        TweenService:Create(track, TweenInfo.new(timeSec), { BackgroundColor3 = nextColor }):Play()
        TweenService:Create(knob, TweenInfo.new(timeSec), { Position = nextKnobPos }):Play()
    end

    updateToggle(false)

    window:BindConnection(textBtn.MouseButton1Click:Connect(function()
        active = not active
        updateToggle(true)
        if flag and window and window.Flags then
            window.Flags[flag] = active
        end
        if window.TriggerAutoSave then window:TriggerAutoSave() end
        task.spawn(callback, active)
    end))

    AddHoverEffect(toggleCard, textBtn, window)
    AddDescriptionHint(textBtn, window, description)

    local toggleObject = {}
    toggleObject._Card = toggleCard
    function toggleObject:SetState(state, silent)
        active = not not state
        updateToggle(true)
        if flag and window and window.Flags then
            window.Flags[flag] = active
        end
        if not silent then
            task.spawn(callback, active)
        end
    end
    function toggleObject:GetValue()
        return active
    end

    -- Add Inline Keybind capability directly onto Toggle instance
    function toggleObject:AddKeybind(defaultKey, keyCallback)
        defaultKey = defaultKey or Enum.KeyCode.None
        keyCallback = keyCallback or function() end

        local boundKey = defaultKey
        local binding = false

        local keyBtn = Create("TextButton", {
            Name = "InlineKeybind",
            Text = boundKey == Enum.KeyCode.None and "[None]" or "[" .. boundKey.Name .. "]",
            Font = Enum.Font.GothamMedium,
            TextSize = 9,
            TextColor3 = window.Theme.MutedText,
            Size = UDim2.new(0, 46, 0, 16),
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -38, 0.5, 0),
            BackgroundColor3 = window.Theme.WidgetBackground,
            ZIndex = 4,
            Parent = toggleCard
        }, {
            Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
            Create("UIStroke", { Thickness = 1, Color = window.Theme.Border, Transparency = window.Theme.WidgetBorderTransparency or 0.85, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
        })

        -- Update title label size to prevent overlap with InlineKeybind badge
        local titleLabel = toggleCard:FindFirstChildOfClass("TextLabel")
        if titleLabel then
            titleLabel.Size = UDim2.new(1, -92, 1, 0)
            titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
            titleLabel.ClipsDescendants = true
        end

        local keyStroke = keyBtn:FindFirstChildOfClass("UIStroke")

        keyBtn.MouseButton1Click:Connect(function()
            if binding then
                binding = false
                keyBtn.Text = boundKey == Enum.KeyCode.None and "[None]" or "[" .. boundKey.Name .. "]"
                if keyStroke then
                    TweenService:Create(keyStroke, TweenInfo.new(0.2), { Color = window.Theme.Border }):Play()
                end
                return
            end
            binding = true
            keyBtn.Text = "[...]"
            if keyStroke then
                TweenService:Create(keyStroke, TweenInfo.new(0.2), { Color = window.Accent }):Play()
            end
        end)

        window:BindConnection(UserInputService.InputBegan:Connect(function(input, processed)
            if binding then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    binding = false
                    if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                        boundKey = Enum.KeyCode.None
                    else
                        boundKey = input.KeyCode
                    end
                    keyBtn.Text = boundKey == Enum.KeyCode.None and "[None]" or "[" .. boundKey.Name .. "]"
                    if keyStroke then
                        TweenService:Create(keyStroke, TweenInfo.new(0.2), { Color = window.Theme.Border }):Play()
                    end
                    task.spawn(keyCallback, boundKey)
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then
                    binding = false
                    keyBtn.Text = boundKey == Enum.KeyCode.None and "[None]" or "[" .. boundKey.Name .. "]"
                    if keyStroke then
                        TweenService:Create(keyStroke, TweenInfo.new(0.2), { Color = window.Theme.Border }):Play()
                    end
                end
            elseif not binding and not processed then
                if input.KeyCode == boundKey and boundKey ~= Enum.KeyCode.None then
                    active = not active
                    updateToggle(true)
                    task.spawn(callback, active)
                    task.spawn(keyCallback, boundKey)
                end
            end
        end))

        local inlineKeyObj = {}
        function inlineKeyObj:SetKey(keyCode)
            boundKey = keyCode or Enum.KeyCode.None
            keyBtn.Text = boundKey == Enum.KeyCode.None and "[None]" or "[" .. boundKey.Name .. "]"
        end
        function inlineKeyObj:GetValue()
            return boundKey
        end

        window:RegisterWidget(tabName .. "/" .. name .. "_Keybind", inlineKeyObj, "Keybind", flag and (flag .. "_Keybind") or nil)
        return inlineKeyObj
    end

    window:RegisterWidget(tabName .. "/" .. name, toggleObject, "Toggle", flag)
    return toggleObject
end

-- Slider control adjustment
function Tab:CreateSlider(name, min, max, default, precise, callback, options)
    -- `options` may be a description string, or a table with the extended knobs:
    --   Decimals = 0    -> whole numbers only ("5", "17")   <- "pake satuan"
    --   Decimals = 1..4 -> fixed decimals ("4.9", "4.91")   <- "pake koma"
    --   Suffix   = "x"  -> unit appended to the readout ("4.91x")
    --   Step     = 5    -> snap to multiples so it never lands on 7.31
    if typeof(options) == "string" then
        options = { Description = options }
    elseif typeof(options) ~= "table" then
        options = {}
    end

    local description = options.Description
    local flag        = options.Flag
    local suffix      = options.Suffix or ""
    local step        = tonumber(options.Step)

    -- `Decimals` wins when supplied; otherwise the legacy `precise` boolean still
    -- maps to 2 decimals (true) or whole numbers (false) so old call sites keep
    -- working unchanged.
    local decimals = tonumber(options.Decimals)
    if not decimals then
        decimals = precise and 2 or 0
    end
    decimals = math.floor(math.clamp(decimals, 0, 4))

    min = min or 0
    max = max or 100
    default = default or min
    callback = callback or function() end

    local function snapToStep(v)
        if step and step > 0 then
            v = min + math.round((v - min) / step) * step
        end
        if decimals <= 0 then
            return math.round(v)
        end
        local factor = 10 ^ decimals
        return math.round(v * factor) / factor
    end

    local function formatValue(v)
        return string.format("%." .. tostring(decimals) .. "f", v) .. suffix
    end

    local value = snapToStep(default)
    local percent = (max > min) and ((value - min) / (max - min)) or 0

    if flag and self.Window and self.Window.Flags then
        self.Window.Flags[flag] = value
    end

    local sliderCard = CreateWidgetBase(self, name, 32, false, {
        Create("TextLabel", {
            Name = "TitleLabel",
            Text = name,
            Font = Enum.Font.GothamMedium,
            TextSize = 10.5,
            TextColor3 = self.Window.Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ClipsDescendants = true,
            Size = UDim2.new(1, -70, 0, 15),
            Position = UDim2.new(0, 4, 0, 2), -- Top row left
            BorderSizePixel = 0,
            BackgroundTransparency = 1
        }),
        Create("TextLabel", {
            Name = "ValLabel",
            Text = formatValue(value),
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = self.Window.Theme.MutedText,
            TextXAlignment = Enum.TextXAlignment.Right,
            TextYAlignment = Enum.TextYAlignment.Top,
            Size = UDim2.new(0, 60, 0, 15),
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -4, 0, 2), -- Top row right
            BorderSizePixel = 0,
            BackgroundTransparency = 1
        }),
        -- Progress Track bar
        Create("Frame", {
            Name = "BarTrack",
            Size = UDim2.new(1, -8, 0, 6), -- Bottom row full width
            Position = UDim2.new(0, 4, 0, 21),
            BackgroundColor3 = self.Window.Theme.InputBackground,
            BorderSizePixel = 0
        }, {
            Create("UICorner", { CornerRadius = UDim.new(0, 3) }),
            -- Progress fill
            Create("Frame", {
                Name = "BarFill",
                Size = UDim2.new(percent, 0, 1, 0),
                BackgroundColor3 = self.Window.Accent,
                BorderSizePixel = 0
            }, {
                Create("UICorner", { CornerRadius = UDim.new(0, 3) }),
                -- Slider Drag Knob Dot
                Create("Frame", {
                    Name = "Knob",
                    Size = UDim2.new(0, 10, 0, 10),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BorderSizePixel = 0,
                    ZIndex = 5
                }, {
                    Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
                    Create("UIStroke", { Name = "KnobStroke", Thickness = 1, Color = self.Window.Accent, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
                })
            }),
            -- Active overlay touch button
            Create("TextButton", {
                Name = "SliderBtn",
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                BorderSizePixel = 0
            })
        })
    })

    local titleLabel = sliderCard.TitleLabel
    local valLabel = sliderCard.ValLabel
    local barTrack = sliderCard.BarTrack
    local barFill = barTrack.BarFill
    local sliderBtn = barTrack.SliderBtn

    local function updateSliderLayout()
        if not sliderCard.Parent then return end
        local cardWidth = sliderCard.AbsoluteSize.X
        if cardWidth <= 0 then return end

        -- Reserve the right-hand 70px for the value readout (which may carry
        -- extra decimals and a unit suffix).
        local maxTitleWidth = math.max(60, cardWidth - 70)
        local titleHeight = 15
        pcall(function()
            local measured = TextService:GetTextSize(titleLabel.Text, 10.5, Enum.Font.GothamMedium, Vector2.new(maxTitleWidth, 10000))
            titleHeight = math.max(15, measured.Y + 2)
        end)

        titleLabel.Size = UDim2.new(0, maxTitleWidth, 0, titleHeight)
        barTrack.Position = UDim2.new(0, 4, 0, titleHeight + 5)
        sliderCard.Size = UDim2.new(1, 0, 0, titleHeight + 17)
    end

    self.Window:BindConnection(titleLabel:GetPropertyChangedSignal("Text"):Connect(updateSliderLayout))
    self.Window:BindConnection(sliderCard:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateSliderLayout))
    task.defer(updateSliderLayout)

    local function updateSlider(newPercent, silent)
        if newPercent ~= newPercent then newPercent = 0 end
        newPercent = math.clamp(newPercent, 0, 1)
        local rawValue = min + (max - min) * newPercent
        value = snapToStep(rawValue)
        -- Re-derive the knob position from the snapped value so whole-number and
        -- stepped sliders visibly click onto their increments instead of floating
        -- between them.
        percent = (max > min) and ((value - min) / (max - min)) or 0
        barFill.Size = UDim2.new(percent, 0, 1, 0)
        valLabel.Text = formatValue(value)
        if flag and self.Window and self.Window.Flags then
            self.Window.Flags[flag] = value
        end
        if not silent then
            if self.Window.TriggerAutoSave then self.Window:TriggerAutoSave() end
            task.spawn(callback, value)
        end
    end

    local dragging = false
    local activeInput = nil
    local beginConn = sliderBtn.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
            dragging = true
            activeInput = input
            local absPos = barTrack.AbsolutePosition
            local absSize = barTrack.AbsoluteSize
            local width = math.max(1, absSize.X)
            local initPercent = math.clamp((input.Position.X - absPos.X) / width, 0, 1)
            updateSlider(initPercent)

            local changeConn;
            local endConn;

            changeConn = self.Window:BindConnection(UserInputService.InputChanged:Connect(function(changeInput)
                if dragging then
                    local isMouseDrag = (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 and changeInput.UserInputType == Enum.UserInputType.MouseMovement)
                    local isTouchDrag = (activeInput and changeInput == activeInput and changeInput.UserInputType == Enum.UserInputType.Touch)
                    if isMouseDrag or isTouchDrag then
                        local currentPos = barTrack.AbsolutePosition
                        local currentSize = barTrack.AbsoluteSize
                        local currentWidth = math.max(1, currentSize.X)
                        local p = math.clamp((changeInput.Position.X - currentPos.X) / currentWidth, 0, 1)
                        updateSlider(p)
                    end
                end
            end))

            endConn = self.Window:BindConnection(UserInputService.InputEnded:Connect(function(endInput)
                if dragging then
                    local isMouseEnd = (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 and endInput.UserInputType == Enum.UserInputType.MouseButton1)
                    local isTouchEnd = (activeInput and endInput == activeInput and endInput.UserInputType == Enum.UserInputType.Touch)
                    if isMouseEnd or isTouchEnd then
                        dragging = false
                        activeInput = nil
                        if changeConn then
                            changeConn:Disconnect()
                            local idx = table.find(self.Window.Connections, changeConn)
                            if idx then table.remove(self.Window.Connections, idx) end
                        end
                        if endConn then
                            endConn:Disconnect()
                            local idx = table.find(self.Window.Connections, endConn)
                            if idx then table.remove(self.Window.Connections, idx) end
                        end
                    end
                end
            end))
        end
    end)
    self.Window:BindConnection(beginConn)

    AddHoverEffect(sliderCard, sliderCard, self.Window)
    AddDescriptionHint(sliderCard, self.Window, description)

    local sliderObject = {}
    sliderObject._Card = sliderCard
    sliderObject.Min = min
    sliderObject.Max = max
    sliderObject.Decimals = decimals
    sliderObject.Suffix = suffix
    function sliderObject:SetValue(newVal, silent)
        local numeric = tonumber(newVal)
        if not numeric then return end
        numeric = math.clamp(numeric, min, max)
        local range = max - min
        local p = (range ~= 0) and ((numeric - min) / range) or 0
        updateSlider(p, silent)
    end
    function sliderObject:GetValue()
        return value
    end
    -- Current readout exactly as rendered, e.g. "4.91x" or "17".
    function sliderObject:GetText()
        return formatValue(value)
    end

    self.Window:RegisterWidget(self.Name .. "/" .. name, sliderObject, "Slider", flag)
    return sliderObject
end

-- Dropdown Option menu
local function CreateDropdownBase(parentTab, isMulti, name, list, default, callback, options)
    options = options or {}
    if typeof(options) == "string" then
