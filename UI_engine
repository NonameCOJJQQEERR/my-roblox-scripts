    local description = (options and options.Description) or nil
    local flag = (options and options.Flag) or nil

    list = list or {}
    callback = callback or function() end

    local window = parentTab.Window
    local active
    if isMulti then
        active = {}
        if type(default) == "table" then
            for _, item in ipairs(default) do
                active[item] = true
            end
        end
    else
        active = default or list[1]
    end

    local function getSelectedList()
        local res = {}
        for _, item in ipairs(list) do
            if active[item] then
