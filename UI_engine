            Position = UDim2.new(0, 4, 0, 0),
            BorderSizePixel = 0,
            BackgroundTransparency = 1
        })
    })

    local labelObj = {}
    labelObj._Card = labelCard
    function labelObj:SetText(txt)
        local t = labelCard:FindFirstChildOfClass("TextLabel")
        if t then t.Text = tostring(txt or "") end
    end
    function labelObj.SetText(selfOrTxt, maybeTxt)
        local txt = (maybeTxt ~= nil) and maybeTxt or selfOrTxt
        local t = labelCard:FindFirstChildOfClass("TextLabel")
        if t then t.Text = tostring(txt or "") end
    end
    function labelObj:GetText()
        local t = labelCard:FindFirstChildOfClass("TextLabel")
        return t and t.Text or ""
    end

    return setmetatable(labelObj, {
        __index = labelCard,
        __newindex = labelCard
    })
end

