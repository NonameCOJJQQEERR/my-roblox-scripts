    end
    function pickerObject:GetValue()
        return currentColor, currentAlpha
    end

    self.Window:RegisterWidget(self.Name .. "/" .. name, pickerObject, "ColorPicker", flag)
    return pickerObject
end
-- Numeric Stepper / Counter control: [-] [value] [+]
--
-- Two ways to call it вЂ” table form (recommended) or positional form that
-- mirrors CreateSlider's ergonomics:
--
--   tab:CreateStepper("Walk Speed", {
--       Min = 16, Max = 250, Step = 1, Default = 16,
--       Suffix = "", Decimals = 0,
--       Flag = "WalkSpeed", Description = "Adjust walk speed",
--       Callback = function(value) end,
--   })
--
--   tab:CreateStepper("Amount", 1, 10, 1, 1, function(v) end, { Flag = "Amount" })
function Tab:CreateStepper(name, min, max, default, step, callback, options)
    local suffix, decimals

    if typeof(min) == "table" then
        -- Table form: every argument arrives inside `min`.
        local opts = min
        min          = opts.Min
        max          = opts.Max
        default      = opts.Default
        step         = opts.Step
        callback     = opts.Callback
        options      = opts
        suffix       = opts.Suffix
        decimals     = opts.Decimals
    else
        -- Positional form: `options` may be a description string or a table.
        if typeof(options) == "string" then
            options = { Description = options }
        elseif typeof(options) ~= "table" then
            options = {}
        end
        suffix   = options.Suffix
        decimals = options.Decimals
    end

    local description = options.Description
    local flag        = options.Flag

    min      = tonumber(min) or 0
    max      = tonumber(max) or 100
    if max < min then min, max = max, min end

    step = tonumber(step) or 1
    if step <= 0 then step = 1 end

    decimals = tonumber(decimals) or 0
    if decimals < 0 then decimals = 0 end
    if decimals > 4 then decimals = 4 end

    suffix = suffix or ""

    local value = tonumber(default) or min
    value = math.clamp(value, min, max)

    local window = self.Window

    -- Snap away float drift so repeated +/- never lands on 0.30000000000000004.
    local function snap(v)
        return math.round(v * 1000) / 1000
    end

    local function formatValue(v)
        if decimals > 0 then
            return string.format("%." .. tostring(decimals) .. "f", v) .. suffix
        end
        return tostring(math.round(v)) .. suffix
    end

    local stepperCard = CreateWidgetBase(self, name, 36, false, {
        -- Title on the left
        Create("TextLabel", {
            Text = name,
            Font = Enum.Font.GothamMedium,
            TextSize = 10.5,
            TextColor3 = window.Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            TextWrapped = true,
            Size = UDim2.new(1, -124, 1, 0), -- leave room for the 110px control
            Position = UDim2.new(0, 4, 0, 0),
            BackgroundTransparency = 1
        }),
        -- Capsule holding [-] [value] [+]
        Create("Frame", {
            Name = "StepperBox",
            Size = UDim2.new(0, 110, 0, 24),
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -4, 0.5, 0),
            BackgroundColor3 = window.Theme.WidgetBackground,
            BackgroundTransparency = 0.5,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            ZIndex = 2
        }, {
            Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
            Create("UIStroke", { Thickness = 1, Color = window.Theme.Border, Transparency = window.Theme.WidgetBorderTransparency or 0.85, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
            -- Minus button
            Create("TextButton", {
                Name = "StepBtn",
                Text = "-",
                Font = Enum.Font.GothamBold,
                TextSize = 14,
                TextColor3 = window.Theme.MutedText,
                Size = UDim2.new(0, 26, 1, 0),
                Position = UDim2.new(0, 0, 0, 0),
                BackgroundColor3 = window.Theme.WidgetHover,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ZIndex = 3
            }),
            -- Value display (also typeable)
            Create("TextBox", {
                Name = "StepValue",
                Text = formatValue(value),
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                TextColor3 = window.Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Center,
                TextYAlignment = Enum.TextYAlignment.Center,
                PlaceholderText = "...",
                PlaceholderColor3 = window.Theme.MutedText,
                LineHeight = 1,
                Size = UDim2.new(0, 58, 1, 0),
                Position = UDim2.new(0, 26, 0, 0),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ClearTextOnFocus = false,
                ZIndex = 3
            }),
            -- Plus button
            Create("TextButton", {
                Name = "StepBtn",
                Text = "+",
                Font = Enum.Font.GothamBold,
                TextSize = 14,
                TextColor3 = window.Theme.MutedText,
                Size = UDim2.new(0, 26, 1, 0),
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, 0, 0, 0),
                BackgroundColor3 = window.Theme.WidgetHover,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ZIndex = 3
            }),
            -- Hairline separators framing the value
            Create("Frame", {
                Name = "StepDivider",
                Size = UDim2.new(0, 1, 1, -8),
                Position = UDim2.new(0, 26, 0, 4),
                BackgroundColor3 = window.Theme.Border,
                BackgroundTransparency = window.Theme.WidgetBorderTransparency or 0.85,
                BorderSizePixel = 0,
                ZIndex = 3
            }),
            Create("Frame", {
                Name = "StepDivider",
                Size = UDim2.new(0, 1, 1, -8),
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -26, 0, 4),
                BackgroundColor3 = window.Theme.Border,
                BackgroundTransparency = window.Theme.WidgetBorderTransparency or 0.85,
                BorderSizePixel = 0,
                ZIndex = 3
            })
        })
    })

    local stepperBox = stepperCard.StepperBox
    local valueBox = stepperBox.StepValue

    local minusBtn, plusBtn
    for _, child in ipairs(stepperBox:GetChildren()) do
        if child.Name == "StepBtn" then
            if child.Text == "-" then minusBtn = child else plusBtn = child end
        end
    end

    if flag and window.Flags then
        window.Flags[flag] = value
    end

    -- ------------------------------------------------------------------
    -- Value plumbing
    -- ------------------------------------------------------------------
    local function setValue(newValue, silent)
        local numeric = tonumber(newValue)
        if not numeric then return end
        value = snap(math.clamp(numeric, min, max))
        valueBox.Text = formatValue(value)

        if flag and window.Flags then
            window.Flags[flag] = value
        end
        if not silent then
            if window.TriggerAutoSave then window:TriggerAutoSave() end
            task.spawn(callback, value)
        end
    end

    local function applyStep(direction)
        setValue(value + (step * direction), false)
    end

    -- ------------------------------------------------------------------
    -- Press-and-hold repeat (release anywhere stops it)
    -- ------------------------------------------------------------------
    local holding = false
    local holdThread = nil

    local function stopHold()
        holding = false
        if holdThread then
            pcall(task.cancel, holdThread)
            holdThread = nil
        end
    end

    local function beginHold(direction)
        stopHold()
        holding = true
        local thread
        thread = task.delay(0.4, function()
            while holding do
                -- Bail out if the window was destroyed mid-hold.
                if not stepperCard.Parent or not stepperBox.Parent then
                    holding = false
                    break
                end
                applyStep(direction)
                task.wait(0.05)
            end
            if holdThread == thread then holdThread = nil end
        end)
        holdThread = thread
    end

    window:BindConnection(UserInputService.InputEnded:Connect(function()
        if holding then stopHold() end
    end))

    -- ------------------------------------------------------------------
    -- Button wiring + hover feedback
    -- ------------------------------------------------------------------
    local function wireButton(btn, direction)
        window:BindConnection(btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                applyStep(direction)
                beginHold(direction)
            end
        end))

        window:BindConnection(btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundTransparency = 0.35 }):Play()
            TweenService:Create(btn, TweenInfo.new(0.15), { TextColor3 = window.Accent }):Play()
        end))

        window:BindConnection(btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(btn, TweenInfo.new(0.15), { TextColor3 = window.Theme.MutedText }):Play()
        end))
    end

    wireButton(minusBtn, -1)
    wireButton(plusBtn, 1)

    -- Typed input: apply on commit, revert on garbage.
    window:BindConnection(valueBox.FocusLost:Connect(function()
        local numeric = tonumber(valueBox.Text)
        if numeric then
            setValue(numeric, false)
        else
            valueBox.Text = formatValue(value)
        end
    end))

    window:BindConnection(valueBox.Focused:Connect(function()
        TweenService:Create(valueBox, TweenInfo.new(0.15), { TextColor3 = window.Accent }):Play()
    end))
    window:BindConnection(valueBox.FocusLost:Connect(function()
        TweenService:Create(valueBox, TweenInfo.new(0.15), { TextColor3 = window.Theme.Text }):Play()
    end))

    AddHoverEffect(stepperCard, stepperCard, window)
    AddDescriptionHint(valueBox, window, description)

    local stepperObject = {}
    stepperObject._Card = stepperCard
    stepperObject.Min = min
    stepperObject.Max = max
    stepperObject.Step = step
    function stepperObject:SetValue(newValue, silent)
        setValue(newValue, silent)
    end
    function stepperObject:GetValue()
        return value
    end
    function stepperObject:Increment()
        applyStep(1)
    end
    function stepperObject:Decrement()
        applyStep(-1)
    end

    window:RegisterWidget(self.Name .. "/" .. name, stepperObject, "Stepper", flag)
    return stepperObject
end
