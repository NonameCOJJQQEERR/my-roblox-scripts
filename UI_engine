                Font = Enum.Font.GothamMedium,
                TextSize = 10,
                TextColor3 = self.Window.Theme.MutedText,
                Size = UDim2.new(0, 15, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1
            }),
            Create("Frame", {
                Name = "Track",
                Size = UDim2.new(1, -25, 0, 8),
                Position = UDim2.new(0, 20, 0.5, -4),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BorderSizePixel = 0
            }, {
                Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
                bgGradient,
                Create("Frame", {
                    Name = "SliderBtnFrame",
                    Size = UDim2.new(0, 6, 1, 4),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(initPercent, 0, 0.5, 0),
                    BackgroundColor3 = Color3.fromRGB(240, 240, 245),
                    BorderSizePixel = 0
                }, {
                    Create("UICorner", { CornerRadius = UDim.new(0, 3) }),
                    Create("UIStroke", { Thickness = 1, Color = self.Window.Theme.Border, Transparency = self.Window.Theme.WidgetBorderTransparency or 0.85, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
                }),
                Create("TextButton", {
                    Name = "SliderBtn",
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    BorderSizePixel = 0
                })
            })
        })

        local track = container.Track
        local sliderBtnFrame = track.SliderBtnFrame
        local sliderBtn = track.SliderBtn

        local function update(pct)
            pct = math.clamp(pct, 0, 1)
            sliderBtnFrame.Position = UDim2.new(pct, 0, 0.5, 0)
        end

        local dragging = false
        sliderBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local absPos = track.AbsolutePosition
                local absSize = track.AbsoluteSize
                local initPct = (input.Position.X - absPos.X) / absSize.X
                update(initPct)
                task.spawn(onDrag, initPct)

                local changeConn
                local endConn

                local function releaseDragConns()
                    -- Mirror pola slider.lua: disconnect + remove dari
                    -- window.Connections supaya registry tidak menumpuk koneksi
                    -- mati dan sweep Destroy tetap menutup koneksi per-drag.
                    if changeConn then
                        changeConn:Disconnect()
                        local idx = table.find(self.Window.Connections, changeConn)
                        if idx then table.remove(self.Window.Connections, idx) end
                        changeConn = nil
                    end
                    if endConn then
                        endConn:Disconnect()
                        local idx = table.find(self.Window.Connections, endConn)
                        if idx then table.remove(self.Window.Connections, idx) end
                        endConn = nil
                    end
                end

                changeConn = self.Window:BindConnection(UserInputService.InputChanged:Connect(function(changeInput)
                    if dragging and (changeInput.UserInputType == Enum.UserInputType.MouseMovement or changeInput.UserInputType == Enum.UserInputType.Touch) then
                        local p = (changeInput.Position.X - absPos.X) / absSize.X
                        update(p)
                        task.spawn(onDrag, p)
                    end
                end))

                endConn = self.Window:BindConnection(UserInputService.InputEnded:Connect(function(endInput)
