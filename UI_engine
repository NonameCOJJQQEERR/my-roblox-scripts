        for _, child in ipairs(sectionSelf.Container:GetChildren()) do
            if child.Name ~= "Header" and child.Name ~= "HeaderDivider" and child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                child.Visible = sectionSelf.Opened
            end
        end
    end

    triggerBtn.MouseButton1Click:Connect(toggleSection)

    -- Fix Roblox AutomaticSize layout bug by manually managing Y size based on UIListLayout with smooth tweening
    local listLayout = sectionSelf.Container:FindFirstChildOfClass("UIListLayout")
    if listLayout then
        local updateThread = nil
        local function updateSize()
            if updateThread then return end
            updateThread = task.defer(function()
                updateThread = nil
                if not sectionSelf.Container or not sectionSelf.Container.Parent then return end
                local targetHeight = listLayout.AbsoluteContentSize.Y + 12
                if math.abs(sectionSelf.Container.Size.Y.Offset - targetHeight) > 1 then
                    TweenService:Create(sectionSelf.Container, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Size = UDim2.new(1, 0, 0, targetHeight)
                    }):Play()
                end
            end)
        end
        local conn = listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSize)
        self.Window:BindConnection(conn)
        sectionSelf.Container.Size = UDim2.new(1, 0, 0, listLayout.AbsoluteContentSize.Y + 12)
    end
    
    return sectionSelf
end
