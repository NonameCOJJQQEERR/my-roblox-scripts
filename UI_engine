-- Resolve where to parent the UI: explicit options.Parent (EzUI standard) or PlayerGui safety net
local function resolveParent(options)
    if options and options.Parent ~= nil then
        return options.Parent
    end
    local lp = Players and Players.LocalPlayer
    if not lp and Players then
        -- Bounded wait: polling dengan deadline, bukan GetPropertyChangedSignal:
        --Wait() yang bisa menggantung thread yatim selamanya kalau LocalPlayer
        -- tidak pernah muncul.
        local deadline = os.clock() + 10
        while not Players.LocalPlayer and os.clock() < deadline do
            pcall(task.wait, 0.1)
        end
        lp = Players.LocalPlayer
    end
    if lp then
        local pg = lp:FindFirstChildOfClass("PlayerGui")
        if not pg then
            local ok, res = pcall(function() return lp:WaitForChild("PlayerGui", 5) end)
            pg = ok and res or nil
        end
        if pg then return pg end
    end
    return nil
end

