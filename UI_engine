function Tab:SetButtonDisabled(btn, disabled)
    if not btn then return end
    local card = (type(btn) == "table" and btn._Card) or btn
    local actionFrame = card:FindFirstChild("ActionBtnFrame", true)
    if actionFrame then
        local textBtn = actionFrame:FindFirstChildOfClass("TextButton")
        if textBtn then
            textBtn.Active = not disabled
            textBtn.Visible = not disabled
        end
        actionFrame.Visible = not disabled
    end
    local autoFrame = card:FindFirstChild("AutoBtnFrame", true)
    if autoFrame then
        local textBtn = autoFrame:FindFirstChildOfClass("TextButton")
        if textBtn then
            textBtn.Active = not disabled
            textBtn.Visible = not disabled
        end
        autoFrame.Visible = not disabled
    end
    local execFrame = card:FindFirstChild("ExecBtnFrame", true)
    if execFrame then
        local textBtn = execFrame:FindFirstChildOfClass("TextButton")
        if textBtn then
            textBtn.Active = not disabled
            textBtn.Visible = not disabled
        end
        execFrame.Visible = not disabled
    end
end

-- Toggle Switch control
