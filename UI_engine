    })

    local boxStroke = inputBox:FindFirstChildOfClass("UIStroke")

    self.Window:BindConnection(inputField.FocusLost:Connect(function(enterPressed)
        TweenService:Create(boxStroke, TweenInfo.new(0.2), { Color = self.Window.Theme.Border, Transparency = 0.9 }):Play()
        TweenService:Create(inputBox, TweenInfo.new(0.2), { BackgroundColor3 = self.Window.Theme.WidgetBackground, BackgroundTransparency = 0.5 }):Play()
        if flag and self.Window and self.Window.Flags then
            self.Window.Flags[flag] = inputField.Text
        end
        if self.Window.TriggerAutoSave then self.Window:TriggerAutoSave() end
        task.spawn(callback, inputField.Text, enterPressed)
    end))

    self.Window:BindConnection(inputField.Focused:Connect(function()
        TweenService:Create(boxStroke, TweenInfo.new(0.2), { Color = self.Window.Accent, Transparency = 0 }):Play()
        TweenService:Create(inputBox, TweenInfo.new(0.2), { BackgroundColor3 = self.Window.Theme.WidgetHover, BackgroundTransparency = 0.4 }):Play()
    end))

    AddHoverEffect(textCard, textCard, self.Window)
    AddDescriptionHint(inputField, self.Window, description)

    local textboxObject = {}
    textboxObject._Card = textCard
    function textboxObject:SetValue(text, silent)
        inputField.Text = tostring(text)
        if flag and self.Window and self.Window.Flags then
            self.Window.Flags[flag] = inputField.Text
        end
        if not silent then
            task.spawn(callback, tostring(text), true)
        end
    end
    function textboxObject:GetValue()
        return inputField.Text
    end

    self.Window:RegisterWidget(self.Name .. "/" .. name, textboxObject, "TextBox", flag)
    return textboxObject
end

-- Keybind listener setter control
function Tab:CreateKeybind(name, default, callback, options)
    local description = nil
    local flag = nil
    if typeof(options) == "string" then
        description = options
    elseif typeof(options) == "table" then
        description = options.Description
        flag = options.Flag
    end

    default = default or Enum.KeyCode.RightShift
    callback = callback or function() end

    local boundKey = default
    local binding = false

    if flag and self.Window and self.Window.Flags then
        self.Window.Flags[flag] = boundKey
    end

    local keybindCard = CreateWidgetBase(self, name, 36, false, {
        Create("TextLabel", {
            Text = name,
            Font = Enum.Font.GothamMedium,
            TextSize = 10.5,
            TextColor3 = self.Window.Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            TextWrapped = true,
            Size = UDim2.new(1, -124, 1, 0), -- Dynamic size leaving space for keybind button
            Position = UDim2.new(0, 4, 0, 0),
            BackgroundTransparency = 1
        }),
        -- Bind toggle button
        Create("TextButton", {
            Name = "BindBtn",
            Text = "[" .. boundKey.Name .. "]",
            Font = Enum.Font.GothamMedium,
            TextSize = 10.5,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(0, 110, 0, 24),
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -4, 0.5, 0),
            BackgroundColor3 = self.Window.Theme.WidgetBackground,
            BackgroundTransparency = 0.5,
            BorderSizePixel = 0
        }, {
            Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
            Create("UIStroke", { Thickness = 1, Color = self.Window.Theme.Border, Transparency = self.Window.Theme.WidgetBorderTransparency or 0.85, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
        })
    })

    local bindBtn = keybindCard.BindBtn
    local btnStroke = bindBtn:FindFirstChildOfClass("UIStroke")

    bindBtn.MouseButton1Click:Connect(function()
        if binding then
            binding = false
            bindBtn.Text = boundKey == Enum.KeyCode.None and "[None]" or "[" .. boundKey.Name .. "]"
            TweenService:Create(btnStroke, TweenInfo.new(0.2), { Color = self.Window.Theme.Border }):Play()
            return
        end
        binding = true
        bindBtn.Text = "[...]"
        TweenService:Create(btnStroke, TweenInfo.new(0.2), { Color = self.Window.Accent }):Play()
    end)

    AddHoverEffect(keybindCard, keybindCard, self.Window)
    AddDescriptionHint(bindBtn, self.Window, description)

    -- Key binding and action trigger handler
    self.Window:BindConnection(UserInputService.InputBegan:Connect(function(input, processed)
        if binding then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                binding = false
                if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                    boundKey = Enum.KeyCode.None
                    bindBtn.Text = "[None]"
                else
                    boundKey = input.KeyCode
                    bindBtn.Text = "[" .. boundKey.Name .. "]"
                end
                TweenService:Create(btnStroke, TweenInfo.new(0.2), { Color = self.Window.Theme.Border }):Play()
                if flag and self.Window and self.Window.Flags then
                    self.Window.Flags[flag] = boundKey
                end
                if self.Window.TriggerAutoSave then self.Window:TriggerAutoSave() end
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then
                binding = false
                bindBtn.Text = boundKey == Enum.KeyCode.None and "[None]" or "[" .. boundKey.Name .. "]"
                TweenService:Create(btnStroke, TweenInfo.new(0.2), { Color = self.Window.Theme.Border }):Play()
            end
        elseif not processed then
            if input.KeyCode == boundKey and boundKey ~= Enum.KeyCode.None then
                task.spawn(callback, boundKey)
            end
        end
    end))

    local keybindObject = {}
    keybindObject._Card = keybindCard
    function keybindObject:SetKey(keyCode)
        if (typeof(keyCode) == "EnumItem" and keyCode.EnumType == Enum.KeyCode) or (type(keyCode) == "table" and keyCode.Name) then
            boundKey = keyCode
            bindBtn.Text = "[" .. boundKey.Name .. "]"
            if flag and self.Window and self.Window.Flags then
                self.Window.Flags[flag] = boundKey
            end
        end
    end
    function keybindObject:GetValue()
        return boundKey
    end

    self.Window:RegisterWidget(self.Name .. "/" .. name, keybindObject, "Keybind", flag)
    return keybindObject
end
for methodName, func in pairs(Tab) do
    if string.find(methodName, "Create") and methodName ~= "CreateSection" then
        Section[methodName] = function(self, ...)
            local element = func(self.Tab, ...)
            local card = (type(element) == "table" and element._Card) or element
            if card and typeof(card) == "Instance" then
                card.Parent = self.Container
                card.BackgroundTransparency = 1
                local stroke = card:FindFirstChildOfClass("UIStroke")
                if stroke then stroke.Enabled = false end

                -- Apply ultra-compact height for widgets inside Section with dynamic Y expansion for multiline titles
                local isExpandable = (methodName == "CreateParagraph" or methodName == "CreateStatusList" or methodName == "CreateColorPicker")
                local baseHeight = isExpandable and card.Size.Y.Offset or (methodName == "CreateSlider" and 32 or 26)
                card.Size = UDim2.new(1, 0, 0, baseHeight)
                
                -- Format title, inject dotted line, and right-align controls for all standard widgets
                if methodName == "CreateToggle" or methodName == "CreateButton" or methodName == "CreateDualButton" or methodName == "CreateKeybind" or methodName == "CreateColorPicker" or methodName == "CreateTextBox" or methodName == "CreateDropdown" or methodName == "CreateMultiDropdown" or methodName == "CreateStepper" then
                    local header = card:FindFirstChild("HeaderFrame")
                    local container = header or card
                    local titleText = container:FindFirstChildOfClass("TextLabel")
                    local control = GetControlElement(card, methodName)

                    if titleText then
                        titleText.ZIndex = 2
                        titleText.BackgroundTransparency = 1
                        titleText.BorderSizePixel = 0
                        titleText.TextWrapped = true
                        titleText.TextTruncate = Enum.TextTruncate.None
                        titleText.TextYAlignment = Enum.TextYAlignment.Center
                        titleText.AnchorPoint = Vector2.new(0, 0.5)
                        titleText.Position = UDim2.new(0, 4, 0.5, 0)
                        
                        -- Add right padding so dots don't touch the text
                        local existingPadding = titleText:FindFirstChildOfClass("UIPadding")
                        if existingPadding then existingPadding:Destroy() end
                        
                        Create("UIPadding", {
                            PaddingLeft = UDim.new(0, 0),
                            PaddingRight = UDim.new(0, 6),
                            Parent = titleText
                        })
                        
                        -- Create Dotted Line Label at ZIndex = 1 (subtle & refined hairline guide)
                        local existingDots = container:FindFirstChild("DottedLine")
                        if existingDots then existingDots:Destroy() end

                        local dotsLabel = Create("TextLabel", {
                            Name = "DottedLine",
                            Text = string.rep(".", 180),
                            Font = Enum.Font.Gotham,
                            TextSize = 9,
                            TextColor3 = self.Window.Theme.MutedText,
                            TextTransparency = 0.75,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            TextYAlignment = Enum.TextYAlignment.Center,
                            Size = UDim2.new(0, 0, 0, 12),
                            AnchorPoint = Vector2.new(0, 0.5),
                            Position = UDim2.new(0, 4, 0.5, -1),
                            BackgroundTransparency = 1,
                            BorderSizePixel = 0,
                            ZIndex = 1,
                            ClipsDescendants = true,
                            Parent = container
                        })

                        if control then
                            control.ZIndex = 2
                            control.AnchorPoint = Vector2.new(1, 0.5)
                            control.Position = UDim2.new(1, -4, 0.5, 0)
                        end

                        -- Dynamic title boundary & multiline wrapped card height updates with caching
                        local cachedSingleLineSize = nil
                        local cachedMultiLineHeights = {}
                        local lastWidth = -1
                        local isUpdating = false
                        
                        local function updateLayout()
                            if isUpdating or not titleText or not titleText.Parent then return end
                            local containerWidth = container.AbsoluteSize.X
                            if containerWidth <= 0 then return end
                            if containerWidth == lastWidth and cachedSingleLineSize then return end
                            lastWidth = containerWidth
                            isUpdating = true

                            local controlWidth = 40
                            if control and control.Parent == container then
                                controlWidth = control.AbsoluteSize.X
                            end

                            local inlineKey = container:FindFirstChild("InlineKeybind") or card:FindFirstChild("InlineKeybind")
                            if inlineKey then
                                controlWidth = controlWidth + inlineKey.AbsoluteSize.X + 8
                            end

                            local maxTitleWidth = math.max(60, containerWidth - controlWidth - 16)
                            
                            if not cachedSingleLineSize then
                                pcall(function()
                                    cachedSingleLineSize = TextService:GetTextSize(titleText.Text, 10.5, Enum.Font.GothamMedium, Vector2.new(10000, 10000))
                                end)
                                if not cachedSingleLineSize then
                                    cachedSingleLineSize = Vector2.new(100, 16)
                                end
                            end

                            if cachedSingleLineSize.X <= maxTitleWidth then
                                titleText.TextWrapped = false
                                titleText.Size = UDim2.new(0, cachedSingleLineSize.X + 6, 0, 16)
                                titleText.Position = UDim2.new(0, 4, 0.5, 0)
                                if header and not isExpandable then
                                    if header.Size.Y.Offset ~= baseHeight then
                                        header.Size = UDim2.new(1, 0, 0, baseHeight)
                                    end
                                end
                                if card.Size.Y.Offset ~= baseHeight then
                                    card.Size = UDim2.new(1, 0, 0, baseHeight)
                                end

                                if dotsLabel then
                                    local startX = 4 + cachedSingleLineSize.X + 4
                                    local controlX = containerWidth - controlWidth - 8
                                    local dotsWidth = math.max(0, controlX - startX)
                                    dotsLabel.Position = UDim2.new(0, startX, 0.5, -1)
                                    dotsLabel.Size = UDim2.new(0, dotsWidth, 0, 12)
                                    dotsLabel.Visible = dotsWidth > 12
                                end
                            else
                                titleText.TextWrapped = true
                                local multiLineHeight = cachedMultiLineHeights[maxTitleWidth]
                                if not multiLineHeight then
                                    pcall(function()
                                        multiLineHeight = TextService:GetTextSize(titleText.Text, 10.5, Enum.Font.GothamMedium, Vector2.new(maxTitleWidth, 10000)).Y + 4
                                    end)
                                    if not multiLineHeight then
                                        multiLineHeight = 32
                                    end
                                    cachedMultiLineHeights[maxTitleWidth] = multiLineHeight
                                end
                                
                                local newCardHeight = math.max(baseHeight, multiLineHeight + 10)
                                titleText.Size = UDim2.new(0, maxTitleWidth, 0, multiLineHeight)
                                titleText.Position = UDim2.new(0, 4, 0.5, 0)

                                if header and not isExpandable then
                                    if header.Size.Y.Offset ~= newCardHeight then
                                        header.Size = UDim2.new(1, 0, 0, newCardHeight)
                                    end
                                end
                                if card.Size.Y.Offset ~= newCardHeight then
                                    card.Size = UDim2.new(1, 0, 0, newCardHeight)
                                end

                                if dotsLabel then
                                    dotsLabel.Visible = false
                                end
                            end
                            isUpdating = false
                        end

                        self.Window:BindConnection(titleText:GetPropertyChangedSignal("Text"):Connect(function()
                            cachedSingleLineSize = nil
                            table.clear(cachedMultiLineHeights)
                            lastWidth = -1
                            updateLayout()
                        end))
                        self.Window:BindConnection(container:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                            if container.AbsoluteSize.X ~= lastWidth then
                                updateLayout()
                            end
                        end))
                        task.defer(updateLayout)
                    end
                end
                
                -- Assign sequential LayoutOrder (starting at 2 to be below Header=0 and Divider=1)
                self.WidgetCount = self.WidgetCount + 1
                card.LayoutOrder = self.WidgetCount + 1
            end
            return element
        end
    end
end

