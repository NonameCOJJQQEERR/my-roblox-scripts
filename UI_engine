                TextColor3 = self.Window.Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Center,
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                ZIndex = 4
            }),
            -- Click trigger button (scoped to just the capsule!)
            Create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                BorderSizePixel = 0,
                ZIndex = 5
            })
        })
    })

    local actionBtnFrame = buttonCard.ActionBtnFrame
    local textBtn = actionBtnFrame:FindFirstChildOfClass("TextButton")
    local btnStroke = actionBtnFrame:FindFirstChildOfClass("UIStroke")
    local btnText = actionBtnFrame.BtnText

