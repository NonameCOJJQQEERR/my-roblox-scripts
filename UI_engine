-- Retrieve Lucide icon assets (URL, Offset, Size) - static catalog only, always reliable
local function getLucideIcon(iconName)
    if not iconName or iconName == "" then
        return "rbxassetid://10723348128", Vector2.new(0, 0), Vector2.new(0, 0) -- settings fallback
    end
    local iconStr = tostring(iconName):lower()

    -- 1. Static catalog (primary - always reliable, no network required)
    if LucideIcons[iconStr] then
        return LucideIcons[iconStr], Vector2.new(0, 0), Vector2.new(0, 0)
    end

    -- 2. Direct rbxassetid passthrough
    if string.find(iconStr, "rbxassetid://") then
        return iconName, Vector2.new(0, 0), Vector2.new(0, 0)
    end

    -- 3. Numeric ID passthrough
    local num = tonumber(iconName)
    if num then
        return "rbxassetid://" .. tostring(num), Vector2.new(0, 0), Vector2.new(0, 0)
    end

    -- 4. Final fallback: settings icon
    return "rbxassetid://10723348128", Vector2.new(0, 0), Vector2.new(0, 0)
end

-- Apply icon data (spritesheet properties or direct fallback) to an ImageLabel
local function ApplyIcon(imageLabel, iconName, defaultName)
    local url, offset, size = getLucideIcon(iconName or defaultName)
    imageLabel.Image = url
    imageLabel.ImageRectOffset = offset
    imageLabel.ImageRectSize = size
end


-- Draggable logic

local function MakeDraggable(window, dragFrame, parentFrame, onDragEnd)
    parentFrame = parentFrame or dragFrame
    local dragging = false
    local dragStart, startPos, activeInput
    local state = {
        WasDragged = false,
        IsDragging = false
    }

    local conn1 = dragFrame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
            dragging = true
            state.IsDragging = true
            state.WasDragged = false
            activeInput = input
            dragStart = input.Position
            startPos = parentFrame.Position
        end
    end)

    -- Smooth cross-platform drag tracking (PC MouseMovement + Mobile Touch)
    local conn2 = UserInputService.InputChanged:Connect(function(input)
        if dragging then
            local isMouseDrag = (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
            local isTouchDrag = (activeInput and input == activeInput and input.UserInputType == Enum.UserInputType.Touch)
            if isMouseDrag or isTouchDrag then
                local delta = input.Position - dragStart
                if delta.Magnitude > 5 then
                    state.WasDragged = true
                end
                parentFrame.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    -- Reliable release detection for both PC and Mobile
    local conn3 = UserInputService.InputEnded:Connect(function(input)
        if dragging then
            local isMouseEnd = (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
            local isTouchEnd = (activeInput and input == activeInput and input.UserInputType == Enum.UserInputType.Touch)
            if isMouseEnd or isTouchEnd then
                dragging = false
                state.IsDragging = false
                activeInput = nil
                if type(onDragEnd) == "function" then
                    task.spawn(onDragEnd, state.WasDragged)
                end
            end
        end
    end)

    if window then
        window:BindConnection(conn1)
        window:BindConnection(conn2)
        window:BindConnection(conn3)
    end

    return state
end

-- Unify hover visual feedback (PC + Mobile)
local function AddHoverEffect(card, triggerButton, window)
    if not triggerButton or not window then return end
    local function onHover()
        pcall(function()
            local isStandalone = (card.Parent and (card.Parent:IsA("ScrollingFrame") or string.find(card.Parent.Name, "Page$")))
            local targetTrans = isStandalone and (window.Theme.CardTransparency or 0) * 0.7 or 0.95
            TweenService:Create(card, TweenInfo.new(0.15), { BackgroundColor3 = window.Theme.Card, BackgroundTransparency = targetTrans }):Play()
        end)
    end
    local function onLeave()
        pcall(function()
            local isStandalone = (card.Parent and (card.Parent:IsA("ScrollingFrame") or string.find(card.Parent.Name, "Page$")))
            local targetTrans = isStandalone and (window.Theme.CardTransparency or 0) or 1
            TweenService:Create(card, TweenInfo.new(0.15), { BackgroundColor3 = window.Theme.Card, BackgroundTransparency = targetTrans }):Play()
        end)
    end
    -- PC
    local c1 = triggerButton.MouseEnter:Connect(onHover)
    local c2 = triggerButton.MouseLeave:Connect(onLeave)
    -- Mobile: brief highlight on tap, restore after release
    local c3 = triggerButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then onHover() end
    end)
    local c4 = triggerButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            task.delay(0.12, onLeave)
        end
    end)
    window:BindConnection(c1)
    window:BindConnection(c2)
    window:BindConnection(c3)
    window:BindConnection(c4)
end

-- Hover description hint for bottombar (PC + Mobile)
local function AddDescriptionHint(triggerElement, window, description)
    if not triggerElement or not description or description == "" or not window then return end
    local function showHint()
        pcall(function()
            if window.Bottombar then
                local statusLabel = window.Bottombar:FindFirstChild("StatusLabel")
                if statusLabel then
                    statusLabel.Text = string.format('<font color="#d4af37">в„№</font>  %s', string.upper(description))
                end
            end
        end)
    end
    local function clearHint()
        pcall(function()
            if window.Bottombar then
                local statusLabel = window.Bottombar:FindFirstChild("StatusLabel")
                if statusLabel then
                    local defaultTitle = string.upper(window.Title or "VALINC QUARTZ")
                    local defaultSub = string.upper(window.Subtitle or "V7.0.0")
                    statusLabel.Text = string.format('<font color="#10b981">в—Џ</font>  %s %s', defaultTitle, defaultSub)
                end
            end
        end)
    end
    -- PC
    local c1 = triggerElement.MouseEnter:Connect(showHint)
    local c2 = triggerElement.MouseLeave:Connect(clearHint)
    -- Mobile
    local c3 = triggerElement.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then showHint() end
    end)
    local c4 = triggerElement.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            task.delay(0.5, clearHint)
        end
    end)
    window:BindConnection(c1)
    window:BindConnection(c2)
    window:BindConnection(c3)
    window:BindConnection(c4)
end

-- Centralized widget base frame constructor
local function CreateWidgetBase(parentTab, name, height, clipsDescendants, children)
    local baseChildren = {
        Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
        Create("UIStroke", { Thickness = 1, Color = parentTab.Window.Theme.Border, Transparency = parentTab.Window.Theme.CardBorderTransparency or 0.92, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
    }
    if children then
        for _, child in ipairs(children) do
            table.insert(baseChildren, child)
        end
    end
    
    local card = Create("Frame", {
        Name = name .. "Card",
        Size = UDim2.new(1, 0, 0, height or 36),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = not not clipsDescendants,
        Active = true, -- Block input passthrough on all widget cards
        Parent = parentTab.Page
    }, baseChildren)
    
    task.defer(function()
        pcall(function()
            if not card or not card.Parent then return end
            local stroke = card:FindFirstChildOfClass("UIStroke")
            if card.Parent:IsA("ScrollingFrame") or string.find(card.Parent.Name, "Page$") then
                card.BackgroundTransparency = parentTab.Window.Theme.CardTransparency or 0
                card.BackgroundColor3 = parentTab.Window.Theme.Card
                if stroke then
                    stroke.Transparency = parentTab.Window.Theme.CardBorderTransparency or 0.3
                end
            else
                card.BackgroundTransparency = 1
                if stroke then
                    stroke.Enabled = false
                end
            end
        end)
    end)
    
    return card
end

-- Retrieve control element for Section dotted-line alignment
local function GetControlElement(card, methodName)
    local header = card:FindFirstChild("HeaderFrame")
    if header then
        if methodName == "CreateDropdown" or methodName == "CreateMultiDropdown" then
            return header:FindFirstChild("SelectorBox")
        elseif methodName == "CreateColorPicker" then
            return header:FindFirstChild("Preview")
        end
    else
        if methodName == "CreateButton" then
            return card:FindFirstChild("ActionBtnFrame")
        elseif methodName == "CreateDualButton" then
            return card:FindFirstChild("ButtonsContainer")
        elseif methodName == "CreateToggle" then
            return card:FindFirstChild("Track")
        elseif methodName == "CreateKeybind" then
            return card:FindFirstChild("BindBtn")
        elseif methodName == "CreateTextBox" then
            return card:FindFirstChild("InputBox")
        elseif methodName == "CreateStepper" then
            return card:FindFirstChild("StepperBox")
        end
    end
    return nil
end

-- Create Window Instance
function ValincUi.CreateWindow(options, options2)
    if options == ValincUi or (type(options) == "table" and rawget(options, "CreateWindow") ~= nil) then
        options = options2
    end
    options = options or {}
    local self = setmetatable({}, ValincUi)
    
    self.Title = options.Title or "Valinc Quartz UI"
    self.Subtitle = options.Subtitle or "v7.0.0"
    self.Logo = options.Logo or "rbxassetid://107101390544126"
    self.Theme = Themes[options.Theme] or Themes.Dark
    self.Accent = options.Accent or self.Theme.Accent
    self.ToggleKey = options.ToggleKey or Enum.KeyCode.RightControl
    self.ConfigFolder = options.ConfigFolder or "valinc_quartz"
    self.CdnUrl = options.CdnUrl
    self.Visible = true
    self.Tabs = {}
    self.ActiveTab = nil
    self.ConfigRegistry = {}
    self.Connections = {}
    self.OnClose = options.OnClose
    self.Flags = {}
    self.AutoLoad = options.AutoLoad
    self.AutoSave = options.AutoSave
    self.ActiveConfigName = (type(options.AutoLoad) == "string" and options.AutoLoad) or "Default"

    -- Category management state
    self.Categories = {}

    local localPlayer = Players and Players.LocalPlayer
    local playerUserId = (localPlayer and localPlayer.UserId) or 0
    local playerDisplayName = (localPlayer and localPlayer.DisplayName) or "Player"

    -- Stealth random GUID (EzUI standard): completely unique per session, no static signature or prefix
    local UI_ROOT_NAME = (HttpService and HttpService:GenerateGUID(false)) or ("G_" .. tostring(math.random(10000000, 99999999)))

    local targetParent = resolveParent(options)
    if targetParent then
        ValincUi.SweepStaleWindows(targetParent, self)
    end

    -- Root ScreenGui: mounted cleanly to targetParent (PlayerGui or explicit Parent)
    self.ScreenGui = Create("ScreenGui", {
        Name = UI_ROOT_NAME,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = options.DisplayOrder or 10000,
        Parent = targetParent
    })
    self.ScreenGui:SetAttribute("__valinc_ui", true)
    ValincUi.RegisterLiveWindow(self)


    -- Window resize bounds: SINGLE SOURCE OF TRUTH for both the UISizeConstraint
    -- and the bottom-right resize handle. They must stay identical вЂ” if the
    -- constraint caps the frame below the drag clamp, the resize code keeps
    -- offsetting Position by the half-delta of a size the frame never reaches,
    -- so the window slides sideways instead of growing.
    local MIN_WINDOW_W, MAX_WINDOW_W = 380, 650
    local MIN_WINDOW_H, MAX_WINDOW_H = 260, 450

    -- Main Container Frame
    local sizeConstraint = Create("UISizeConstraint", {
        MinSize = Vector2.new(MIN_WINDOW_W, MIN_WINDOW_H),
        MaxSize = Vector2.new(MAX_WINDOW_W, MAX_WINDOW_H)
