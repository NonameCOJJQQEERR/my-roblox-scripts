            TweenService:Create(btnStroke, TweenInfo.new(0.15), { Color = self.Window.Accent, Transparency = 0 }):Play()
        end
    end))

    self.Window:BindConnection(textBtn.MouseLeave:Connect(function()
        isHovering = false
        local inactiveBg = self.Window.Theme.WidgetBackground
        TweenService:Create(actionBtnFrame, TweenInfo.new(0.15), { BackgroundColor3 = inactiveBg }):Play()
        TweenService:Create(btnText, TweenInfo.new(0.15), { TextColor3 = self.Window.Theme.Text }):Play()
        if btnStroke then
            TweenService:Create(btnStroke, TweenInfo.new(0.15), { Color = self.Window.Theme.Border, Transparency = self.Window.Theme.WidgetBorderTransparency or 0.85 }):Play()
        end
    end))

    self.Window:BindConnection(textBtn.MouseButton1Click:Connect(function()
        -- Flash feedback (lights up with accent color on click)
        actionBtnFrame.BackgroundColor3 = self.Window.Accent
        btnText.TextColor3 = Color3.fromRGB(255, 255, 255)
        if btnStroke then
            btnStroke.Color = self.Window.Accent
            btnStroke.Transparency = 0
        end

        task.delay(0.1, function()
            local targetBg = isHovering and self.Window.Theme.WidgetHover or self.Window.Theme.WidgetBackground
            local targetText = self.Window.Theme.Text
            local targetStrokeColor = isHovering and self.Window.Accent or self.Window.Theme.Border
            local targetStrokeTrans = isHovering and 0 or (self.Window.Theme.WidgetBorderTransparency or 0.85)

            TweenService:Create(actionBtnFrame, TweenInfo.new(0.25), { BackgroundColor3 = targetBg }):Play()
            TweenService:Create(btnText, TweenInfo.new(0.25), { TextColor3 = targetText }):Play()
            if btnStroke then
                TweenService:Create(btnStroke, TweenInfo.new(0.25), { Color = targetStrokeColor, Transparency = targetStrokeTrans }):Play()
            end
        end)
        
        task.spawn(callback)
    end))

    return buttonCard
end

