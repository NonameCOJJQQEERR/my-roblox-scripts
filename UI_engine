    end

    local toggleCard = CreateWidgetBase(self, name, 36, false, {
        Create("TextButton", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
            BorderSizePixel = 0
