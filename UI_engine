local function Create(class, properties, children)
    local inst = Instance.new(class)
    for k, v in pairs(properties or {}) do inst[k] = v end
    for _, child in ipairs(children or {}) do child.Parent = inst end
    return inst
end

local function FormatAssetId(assetStr)
    if type(assetStr) == "string" then
        if string.find(assetStr, "rbxthumb://") then return assetStr end
        local id = string.match(assetStr, "rbxassetid://(%d+)") or string.match(assetStr, "id=(%d+)") or string.match(assetStr, "^(%d+)$")
        if id then
            if string.len(id) >= 10 then return "rbxassetid://" .. id end
            return "rbxthumb://type=Asset&id=" .. id .. "&w=150&h=150"
        end
        return assetStr
    elseif type(assetStr) == "number" then
        local idStr = tostring(assetStr)
        if string.len(idStr) >= 10 then return "rbxassetid://" .. idStr end
        return "rbxthumb://type=Asset&id=" .. idStr .. "&w=150&h=150"
    end
    return assetStr
end

