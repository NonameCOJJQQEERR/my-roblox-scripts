-- Live-window registry: mencegah listener-stacking saat CreateWindow dipanggil
-- ulang / hot-reload. Koneksi service-level (UserInputService, RunService)
-- hidup di tabel window (window.Connections), bukan di ScreenGui вЂ” jadi sweep
-- harus :Destroy() window object-nya, bukan hanya gui-nya. Registry di-anchor
-- di getgenv agar salinan library hasil loadstring terpisah berbagi satu
-- tabel; weak keys agar window yang sudah tidak dirujuk bisa ter-drop sendiri.
local function GetLiveWindowRegistry()
    local ok, anchor = pcall(getgenv)
    if not ok or type(anchor) ~= "table" then
        anchor = _G
    end
    local reg = anchor.__ValincLiveWindows
    if type(reg) ~= "table" then
        reg = setmetatable({}, { __mode = "k" })
        anchor.__ValincLiveWindows = reg
    end
    return reg
end

function ValincUi.RegisterLiveWindow(window)
    if type(window) == "table" and typeof(window.ScreenGui) == "Instance" then
        GetLiveWindowRegistry()[window.ScreenGui] = window
    end
end

-- Destroy semua ScreenGui warisan Valinc di bawah parent. Prioritas: panggil
-- :Destroy() window object pemiliknya supaya semua koneksi service-level ikut
-- putus. Fallback: destroy gui saja (salinan lama tanpa registry / gui pihak
-- ketiga).
function ValincUi.SweepStaleWindows(parent, skipWindow)
    if typeof(parent) ~= "Instance" then return end
    local registry = GetLiveWindowRegistry()
    local keepGui = skipWindow and skipWindow.ScreenGui or nil
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("ScreenGui") and child:GetAttribute("__valinc_ui") and child ~= keepGui then
            local old = registry[child]
            if type(old) == "table" and old ~= skipWindow and type(old.Destroy) == "function" then
                pcall(function() old:Destroy() end)
            else
                pcall(function() child:Destroy() end)
            end
        end
    end
end

