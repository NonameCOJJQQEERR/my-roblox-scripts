    local function getDropdownWidth()
        local longestWidth = 0
        local font = Enum.Font.Gotham
        local textSize = 11

        for _, item in ipairs(list) do
            local itemStr = tostring(item)
            local success, size = pcall(function()
                return TextService:GetTextSize(itemStr, textSize, font, Vector2.new(10000, 10000))
            end)
            if success and size and size.X > longestWidth then
                longestWidth = size.X
            end
        end

        -- Layout calculation:
        -- optionsContainer Padding: Left(6) + Right(6) = 12
        -- optBtn Padding: Left(8) + Right(24) = 32
        -- Scrollbar allowance (when list > 8 items): 6
        -- Aesthetic breathing room: 10
        -- Total overhead = 12 + 32 + 6 + 10 = 60
        local finalWidth = math.ceil(longestWidth + 60)
        local minWidth = 140
        local screenW = (window.ScreenGui and window.ScreenGui.AbsoluteSize.X) or 1920
        local maxWidth = math.min(380, math.floor(screenW * 0.45))
        return math.clamp(finalWidth, minWidth, maxWidth)
