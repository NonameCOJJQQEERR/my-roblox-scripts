function Tab:CreateDropdown(name, list, default, callback, keepOpen, description)
    local opts = {}
    if typeof(keepOpen) == "string" then
        opts.Description = keepOpen
        opts.KeepOpen = false
    elseif typeof(keepOpen) == "table" then
        opts = keepOpen
    else
        opts.KeepOpen = keepOpen
        if typeof(description) == "string" then
            opts.Description = description
        elseif typeof(description) == "table" then
            for k, v in pairs(description) do opts[k] = v end
        end
    end
    return CreateDropdownBase(self, false, name, list, default, callback, opts)
end
function Tab:CreateMultiDropdown(name, list, default, callback, description)
    local opts = {}
    if typeof(description) == "string" then
        opts.Description = description
    elseif typeof(description) == "table" then
        opts = description
    elseif typeof(default) == "table" and not callback and not description then
        -- Edge case: list, default omitted
    end
    return CreateDropdownBase(self, true, name, list, default, callback, opts)
end
