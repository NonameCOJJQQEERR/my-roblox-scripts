    AddHoverEffect(pickerCard, triggerBtn, self.Window)
    AddDescriptionHint(triggerBtn, self.Window, description)

    local pickerObject = {}
    pickerObject._Card = pickerCard
    function pickerObject:SetColor(color, alpha, silent)
        currentColor = color
        currentAlpha = alpha or currentAlpha
        h, s, v = Color3.toHSV(currentColor)
        updateHue(h)
        updateSat(s)
        updateVal(v)
        updateAlpha(1 - currentAlpha)
        if not silent then
            updateColor()
        else
            pickerCard.HeaderFrame.Preview.BackgroundColor3 = currentColor
            hexField.Text = Color3ToHex(currentColor)
            if flag and self.Window and self.Window.Flags then
                self.Window.Flags[flag] = currentColor
