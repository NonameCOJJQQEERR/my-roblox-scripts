        Size = UDim2.new(1, 0, 0, 2),
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = theme.MutedText,
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = notifyCard
    })

    -- Safe container fallback
    local container = (self and self.NotifyContainer)
    if not container then
        local targetParent = resolveParent()
        local ParentUI = (self and self.ScreenGui)
        if not ParentUI and targetParent then
            for _, child in ipairs(targetParent:GetChildren()) do
                if child:IsA("ScreenGui") and child:GetAttribute("__valinc_ui") then ParentUI = child; break end
            end
            if not ParentUI then
                local notifyName = (HttpService and HttpService:GenerateGUID(false)) or ("Notif_" .. tostring(math.random(100000, 999999)))
                ParentUI = Create("ScreenGui", {
                    Name = notifyName,
                    ResetOnSpawn = false,
                    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
                    Parent = targetParent
                })
                ParentUI:SetAttribute("__valinc_ui", true)
            end
        end
        if ParentUI then
            container = ParentUI:FindFirstChild("NotifyContainer")
            if not container then
                container = Create("Frame", {
                    Name = "NotifyContainer",
                    Size = UDim2.new(0, 220, 1, -20),
                    Position = UDim2.new(1, -230, 0, 10),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Parent = ParentUI
                }, {
                    Create("UIListLayout", {
                        Padding = UDim.new(0, 6),
                        VerticalAlignment = Enum.VerticalAlignment.Bottom,
                        HorizontalAlignment = Enum.HorizontalAlignment.Right,
                        SortOrder = Enum.SortOrder.LayoutOrder
                    })
                })
            end
        end
    end
    if not container then
        pcall(function() notifyCard:Destroy() end)
        return
    end
    notifyCard.Parent = container

    -- Slide in from right
    notifyCard.Position = UDim2.new(1.05, 0, 0, 0)
    TweenService:Create(notifyCard, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    -- Progress countdown
    TweenService:Create(progressLine, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2)
    }):Play()

    -- Dismiss
    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        local exit = TweenService:Create(notifyCard, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1.05, 0, 0, 0)
        })
        exit:Play()
        exit.Completed:Connect(function()
            notifyCard:Destroy()
        end)
    end

    task.delay(duration, dismiss)
end

-- Ensure config directory exists
local function ensureConfigDir(folderName)
    folderName = folderName or "valinc_quartz"
    if makefolder then
        pcall(makefolder, folderName)
        pcall(makefolder, folderName .. "/configs")
    end
end

local autoSaveThreads = setmetatable({}, { __mode = "k" })

-- Register a stateful widget for configuration auto-save/load and Flags synchronization
function ValincUi:RegisterWidget(key, widgetObject, widgetType, flag)
    if not self.ConfigRegistry then
        self.ConfigRegistry = {}
    end
    self.ConfigRegistry[key] = {
        Object = widgetObject,
        Type = widgetType,
        Flag = flag
    }
end

-- Trigger debounced auto-save when AutoSave is enabled
function ValincUi:TriggerAutoSave()
    if not self.AutoSave then return end
    local thread = autoSaveThreads[self]
    if thread and coroutine.running() ~= thread then
        pcall(task.cancel, thread)
    end
    autoSaveThreads[self] = task.delay(1.0, function()
        autoSaveThreads[self] = nil
        local cfgName = self.ActiveConfigName or "Default"
        pcall(function() self:SaveConfig(cfgName) end)
    end)
end

-- Get current flag value
function ValincUi:GetFlag(flag)
    return self.Flags and self.Flags[flag]
end

-- Set flag value programmatically and sync matching widget
function ValincUi:SetFlag(flag, value, silent)
    if not self.Flags then self.Flags = {} end
    self.Flags[flag] = value
    if self.ConfigRegistry then
        for _, reg in pairs(self.ConfigRegistry) do
            if reg.Flag == flag then
                pcall(function()
                    if reg.Type == "Toggle" then
                        reg.Object:SetState(value, silent)
                    elseif reg.Type == "Slider" or reg.Type == "Dropdown" or reg.Type == "MultiDropdown" or reg.Type == "TextBox" or reg.Type == "Stepper" then
                        reg.Object:SetValue(value, silent)
                    elseif reg.Type == "ColorPicker" then
                        if typeof(value) == "Color3" then reg.Object:SetColor(value, nil, silent) end
                    elseif reg.Type == "Keybind" then
                        reg.Object:SetKey(value)
                    end
                end)
                break
            end
        end
    end
end

-- Helper to serialize the config registry to a standard Lua table
function ValincUi:SerializeRegistry()
    local data = {}
    for key, widget in pairs(self.ConfigRegistry) do
        local success, val = pcall(function()
            return widget.Object:GetValue()
        end)
        if success then
            if widget.Type == "ColorPicker" then
                local color, alpha = widget.Object:GetValue()
                data[key] = {
                    r = color.R,
                    g = color.G,
                    b = color.B,
                    a = alpha
                }
            elseif widget.Type == "Keybind" then
                local boundKey = widget.Object:GetValue()
                data[key] = boundKey and boundKey.Name or "None"
            else
                data[key] = val
            end
        end
    end
    return data
end

-- Helper to deserialize config data and apply it to matching widgets
function ValincUi:DeserializeRegistry(data, silent)
    if silent == nil then silent = false end
    for key, savedVal in pairs(data) do
        local widget = self.ConfigRegistry[key]
        if widget then
            pcall(function()
                if widget.Type == "Toggle" then
                    widget.Object:SetState(savedVal, silent)
                elseif widget.Type == "Slider" then
                    widget.Object:SetValue(savedVal, silent)
                elseif widget.Type == "Dropdown" then
                    widget.Object:SetValue(savedVal, silent)
                elseif widget.Type == "MultiDropdown" then
                    widget.Object:SetValue(savedVal, silent)
                elseif widget.Type == "ColorPicker" then
                    if type(savedVal) == "table" and savedVal.r then
                        widget.Object:SetColor(Color3.new(savedVal.r, savedVal.g, savedVal.b), savedVal.a, silent)
                    end
                elseif widget.Type == "TextBox" or widget.Type == "Stepper" then
                    widget.Object:SetValue(savedVal, silent)
                elseif widget.Type == "Keybind" then
                    local code = Enum.KeyCode[savedVal]
                    if code then
                        widget.Object:SetKey(code)
                    end
                end
                if widget.Flag and self.Flags then
                    pcall(function()
                        self.Flags[widget.Flag] = widget.Object:GetValue()
                    end)
                end
            end)
        end
    end
end

-- Save configuration by name
function ValincUi:SaveConfig(name)
    -- Sanitize: config names become file paths, so strip path separators and
    -- control chars ("../x" or "a/b" would escape the configs folder).
    name = tostring(name):gsub("[^%w%-_ ]", "_")
    if name == "" then return false, "Invalid name" end
    self.ActiveConfigName = name
    local folder = self.ConfigFolder or "valinc_quartz"
    ensureConfigDir(folder)
    
    local serializedData = self:SerializeRegistry()
    local success, json = pcall(function()
        return HttpService:JSONEncode(serializedData)
    end)
    
    if success and json then
        if writefile then
            local filePath = folder .. "/configs/" .. name .. ".json"
            local writeSuccess, err = pcall(writefile, filePath, json)
            if writeSuccess then
                return true
            else
                return false, tostring(err)
            end
        else
            return false, "Executor writefile function not supported in this environment"
        end
    end
    return false, "JSON encoding failed"
end

-- Load configuration by name
function ValincUi:LoadConfig(name, silent)
    name = tostring(name):gsub("[^%w%-_ ]", "_")  -- must match SaveConfig's sanitize
    if name == "" then return false, "Invalid name" end
    local folder = self.ConfigFolder or "valinc_quartz"
    ensureConfigDir(folder)
    
    local filePath = folder .. "/configs/" .. name .. ".json"
    if isfile and isfile(filePath) then
        local readSuccess, json = pcall(readfile, filePath)
        if readSuccess and json then
            local decodeSuccess, data = pcall(function()
                return HttpService:JSONDecode(json)
            end)
            if decodeSuccess and type(data) == "table" then
                self.ActiveConfigName = name
                self:DeserializeRegistry(data, silent)
                return true
            else
                return false, "JSON decoding failed"
            end
        else
            return false, "Read file failed"
        end
    else
        return false, "Config file does not exist"
    end
end

-- Retrieve list of saved configs (returns array of names)
function ValincUi:GetConfigs()
    local folder = self.ConfigFolder or "valinc_quartz"
    ensureConfigDir(folder)
    local configs = {}
    if listfiles then
        local files = {}
        pcall(function()
            files = listfiles(folder .. "/configs")
        end)
        for _, file in ipairs(files) do
            local name = file:match("([^/\\]+)%.json$")
            if name then
                table.insert(configs, name)
            end
        end
    end
    return configs
end

-- Watermark Overlay component (FPS, Ping, User, Time)
function ValincUi:Watermark(options)
    options = options or {}
    local windowSelf = self
    local theme = (windowSelf and windowSelf.Theme) or Themes.Dark

    local parentGui = (windowSelf and windowSelf.ScreenGui)
    if not parentGui then
        local targetParent = resolveParent(options)
        if targetParent then
            local wmName = (HttpService and HttpService:GenerateGUID(false)) or ("WM_" .. tostring(math.random(100000, 999999)))
            parentGui = Create("ScreenGui", {
                Name = wmName,
                ResetOnSpawn = false,
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
                Parent = targetParent
            })
            parentGui:SetAttribute("__valinc_ui", true)
        end
    end

    local watermarkCard = Create("Frame", {
        Name = "WatermarkCard",
        Size = UDim2.new(0, 0, 0, 24),
        AutomaticSize = Enum.AutomaticSize.X,
        Position = UDim2.new(1, -15, 0, 15),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = theme.Card,
        BackgroundTransparency = theme.CardTransparency or 0.15,
        BorderSizePixel = 0,
        ZIndex = 300,
        Parent = parentGui
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
        Create("UIStroke", { Thickness = 1, Color = theme.Border, Transparency = 0.4 }),
        Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
        Create("TextLabel", {
            Name = "WMText",
            Text = "VALINC  |  60 FPS  |  0 ms",
            Font = Enum.Font.GothamMedium,
            TextSize = 10,
            TextColor3 = theme.Text,
            TextXAlignment = Enum.TextXAlignment.Center,
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            ZIndex = 301
        })
    })

    local wmText = watermarkCard.WMText
    local lastUpdate = os.clock()
    local frameCount = 0
    local fps = 60

    local dataPingItem = nil
    pcall(function()
        local stats = game:GetService("Stats")
        if stats and stats.Network and stats.Network.ServerStatsItem then
            dataPingItem = stats.Network.ServerStatsItem["Data Ping"]
        end
    end)

    local conn = RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = os.clock()
        if now - lastUpdate >= 0.5 then
            fps = math.round(frameCount / (now - lastUpdate))
            frameCount = 0
            lastUpdate = now

            local ping = 0
            if dataPingItem then
                pcall(function()
                    ping = math.round(dataPingItem:GetValue())
                end)
            end

            local timeStr = os.date("%H:%M:%S")
            wmText.Text = string.format("VALINC QUARTZ  |  %d FPS  |  %d ms  |  %s", fps, ping, timeStr)
        end
    end)
    if windowSelf and typeof(windowSelf.BindConnection) == "function" then
        windowSelf:BindConnection(conn)
    end

    MakeDraggable(self, watermarkCard, watermarkCard)

    local watermarkObj = {}
    function watermarkObj:SetVisible(vis)
        watermarkCard.Visible = vis
    end
    function watermarkObj:Destroy()
        if conn then conn:Disconnect() end
        watermarkCard:Destroy()
    end
    return watermarkObj
end

-- Helper to generate a full Config Manager Section automatically
function ValincUi:CreateConfigSection(parentTab)
    if not parentTab then return end
    local windowSelf = self

    local section = parentTab:CreateSection("Config Manager", "folder-cog")

    -- 1. Config Selector Dropdown
    local configList = windowSelf:GetConfigs()
    if #configList == 0 then table.insert(configList, "Default") end
    
    local selectedConfig = configList[1] or "Default"
    local configDropdown = section:CreateDropdown("Select Profile", configList, selectedConfig, function(val)
        selectedConfig = val
    end, "Choose a saved configuration profile to load or delete.")

    -- 2. New Config Name Input
    local configNameInput = section:CreateTextBox("Config Name", "Enter name...", function() end, "Enter a custom profile name for saving.")

    -- 3. Action Buttons (Save & Load)
    section:CreateDualButton("Config Actions", "SAVE", "LOAD", false, function()
        -- Save action
        local saveName = configNameInput:GetValue()
        if not saveName or saveName == "" then saveName = selectedConfig end
        if not saveName or saveName == "" then saveName = "Default" end

        local ok, err = windowSelf:SaveConfig(saveName)
        if ok then
            windowSelf:Notify("Config Saved", "Saved profile '" .. saveName .. "' successfully!", 4)
            local newConfigs = windowSelf:GetConfigs()
            configDropdown:Refresh(newConfigs, saveName)
            selectedConfig = saveName
        else
            windowSelf:Notify("Save Failed", tostring(err), 4)
        end
    end, function()
        -- Load action
        if not selectedConfig or selectedConfig == "" then
            windowSelf:Notify("Load Failed", "No config selected!", 4)
            return
        end

        local ok, err = windowSelf:LoadConfig(selectedConfig)
        if ok then
            windowSelf:Notify("Config Loaded", "Loaded profile '" .. selectedConfig .. "' successfully!", 4)
        else
            windowSelf:Notify("Load Failed", tostring(err), 4)
        end
    end, "Save current settings or Load selected profile.")

    -- 4. Utility Buttons (Delete & Refresh)
    section:CreateDualButton("Config Utils", "DELETE", "REFRESH", false, function()
        -- Delete action
        if not selectedConfig or selectedConfig == "" then return end
        local folder = windowSelf.ConfigFolder or "valinc_quartz"
        local filePath = folder .. "/configs/" .. selectedConfig .. ".json"
        if delfile and isfile and isfile(filePath) then
            pcall(delfile, filePath)
            windowSelf:Notify("Config Deleted", "Deleted profile '" .. selectedConfig .. "'", 4)
            local newConfigs = windowSelf:GetConfigs()
            selectedConfig = newConfigs[1] or ""
            configDropdown:Refresh(newConfigs, selectedConfig)
        end
    end, function()
        -- Refresh action
        local newConfigs = windowSelf:GetConfigs()
        configDropdown:Refresh(newConfigs, selectedConfig)
        windowSelf:Notify("Configs Refreshed", "Found " .. tostring(#newConfigs) .. " saved profiles.", 3)
    end, "Delete selected profile or Refresh config list.")

    return section
end

-- Create Sidebar tab Page
local Tab = {}
Tab.__index = Tab

function ValincUi:CreateTab(name, arg2, arg3)
    local category = "Navigation"
    local iconName = nil
    
    if arg3 ~= nil then
        -- 3 arguments: CreateTab(name, iconName, category)
        iconName = arg2
        category = arg3
    elseif arg2 ~= nil then
        -- 2 arguments: CreateTab(name, arg2)
        local arg2Str = tostring(arg2):lower()
        if arg2Str == "modules" or arg2Str == "navigation" or arg2Str == "world" then
            category = arg2
        else
            iconName = arg2
        end
    end

    local catUpper = string.upper(category)
    
    local tabSelf = setmetatable({}, Tab)
    tabSelf.Window = self
    tabSelf.Name = name

    self.Categories = self.Categories or {}

    -- Sidebar order = CREATION order (first tab at the top, last at the bottom).
    -- The old scheme bucketed categories at fixed offsets (MODULES=100 /
    -- NAVIGATION=200 / WORLD=300), which shuffled tabs out of the order the
    -- script created them in. Headers now claim a slot in the sequence when
    -- their category first appears, so a header always sits just above its
    -- first tab.
    self.TabSequence = (self.TabSequence or 0) + 1
    if not self.Categories[catUpper] then
        local headerLabel = Create("TextLabel", {
            Name = catUpper .. "Header",
            Text = catUpper,
            Font = Enum.Font.GothamBold,
            TextSize = 8,
            TextColor3 = self.Theme.MutedText,
            TextTransparency = 0.5,
            TextXAlignment = Enum.TextXAlignment.Left,
            Size = UDim2.new(1, -4, 0, 16),
            Position = UDim2.new(0, 4, 0, 0),
            BackgroundTransparency = 1,
            LayoutOrder = self.TabSequence,
            Parent = self.TabList
        })
        self.Categories[catUpper] = headerLabel
        self.TabSequence += 1
    end
    local tabOrder = self.TabSequence

    local defaultIcons = {
        ["Player Hacks"] = "user",
        ["ESP & Vis"] = "eye",
        ["Miscellaneous"] = "settings",
        ["Aimbot"] = "target",
        ["World"] = "globe"
    }
    local resolvedIconName = iconName or defaultIcons[name] or "settings"
    local iconUrl, iconOffset, iconSize = getLucideIcon(resolvedIconName)

    -- Sidebar item button (dynamic Y auto-sizing for multi-line text wrapping)
    tabSelf.Button = Create("TextButton", {
        Name = name .. "TabBtn",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        Text = "",
        LayoutOrder = tabOrder,
        Parent = self.TabList
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
        -- Content Row container with UIListLayout for icon + text alignment
        Create("Frame", {
            Name = "ContentRow",
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            BorderSizePixel = 0
        }, {
            Create("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                Padding = UDim.new(0, 6),
                SortOrder = Enum.SortOrder.LayoutOrder
            }),
            Create("UIPadding", {
                PaddingTop = UDim.new(0, 6),
                PaddingBottom = UDim.new(0, 6),
                PaddingLeft = UDim.new(0, 10),
                PaddingRight = UDim.new(0, 10)
            }),
            -- Icon label
            Create("ImageLabel", {
                Name = "IconLabel",
                Image = iconUrl,
                ImageRectOffset = iconOffset,
                ImageRectSize = iconSize,
                ImageColor3 = self.Theme.MutedText,
                ScaleType = Enum.ScaleType.Fit,
                Size = UDim2.new(0, 16, 0, 16),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                LayoutOrder = 1
            }),
            -- Tab Text (Multi-line text wrapping enabled)
            Create("TextLabel", {
                Name = "TabLabel",
                Text = name,
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                TextColor3 = self.Theme.MutedText,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Center,
                TextWrapped = true,
                TextTruncate = Enum.TextTruncate.None,
                Size = UDim2.new(1, -22, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder = 2
            })
        })
    })

    -- Tab scrolling pane layout page
    tabSelf.Page = Create("ScrollingFrame", {
        Name = name .. "Page",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = self.Theme.Border,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ClipsDescendants = true,
        Visible = false,
        Active = true, -- Block click-through on the tab scrolling page
        Parent = self.MainContainer
    }, {
        Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder
        }),
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12)
        })
    })

    table.insert(self.Tabs, tabSelf)

    local iconLabel = tabSelf.Button:FindFirstChild("IconLabel", true)
    local tabLabel = tabSelf.Button:FindFirstChild("TabLabel", true)
    local function selectTab()
        -- Deactivate all other tabs
        for _, otherTab in ipairs(self.Tabs) do
            if otherTab ~= tabSelf then
                otherTab.Page.Visible = false
                TweenService:Create(otherTab.Button, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
                
                local otherIcon = otherTab.Button:FindFirstChild("IconLabel", true)
                if otherIcon then
                    TweenService:Create(otherIcon, TweenInfo.new(0.2), { ImageColor3 = self.Theme.MutedText }):Play()
                end
                local otherTabLabel = otherTab.Button:FindFirstChild("TabLabel", true)
                if otherTabLabel then
                    TweenService:Create(otherTabLabel, TweenInfo.new(0.2), { TextColor3 = self.Theme.MutedText }):Play()
                end
            end
        end

        -- Activate target tab page
        tabSelf.Page.Visible = true
        self.ActiveTab = tabSelf
        
        -- High end selected styling: card background + subtle stroke border
        TweenService:Create(tabSelf.Button, TweenInfo.new(0.2), { BackgroundTransparency = 0.95, BackgroundColor3 = self.Theme.Text }):Play()
        if iconLabel then
            TweenService:Create(iconLabel, TweenInfo.new(0.2), { ImageColor3 = self.Theme.Text }):Play()
        end
        if tabLabel then
            TweenService:Create(tabLabel, TweenInfo.new(0.2), { TextColor3 = self.Theme.Text }):Play()
        end
    end

    self:BindConnection(tabSelf.Button.MouseButton1Click:Connect(selectTab))

    self:BindConnection(tabSelf.Button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tabSelf then
            if tabLabel then
                TweenService:Create(tabLabel, TweenInfo.new(0.15), { TextColor3 = self.Theme.Text }):Play()
            end
            if iconLabel then
                TweenService:Create(iconLabel, TweenInfo.new(0.15), { ImageColor3 = self.Theme.Text }):Play()
            end
            TweenService:Create(tabSelf.Button, TweenInfo.new(0.15), { BackgroundTransparency = 0.95, BackgroundColor3 = self.Theme.Text }):Play()
        end
    end))
    self:BindConnection(tabSelf.Button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tabSelf then
            if tabLabel then
                TweenService:Create(tabLabel, TweenInfo.new(0.15), { TextColor3 = self.Theme.MutedText }):Play()
            end
            if iconLabel then
                TweenService:Create(iconLabel, TweenInfo.new(0.15), { ImageColor3 = self.Theme.MutedText }):Play()
            end
            TweenService:Create(tabSelf.Button, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
        end
    end))

    -- Auto-select the first created tab page
    if #self.Tabs == 1 then
        selectTab()
    end

    return tabSelf
end

