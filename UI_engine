    local function getFloatPosAndHeight()
        local mf = window.MainFrame
        local topInset = 0
        pcall(function()
            if GuiService then
                topInset = GuiService:GetGuiInset().Y
            end
        end)

        local currentWidth = getDropdownWidth()
        local screenW = (window.ScreenGui and window.ScreenGui.AbsoluteSize.X) or 1920
        local screenH = (window.ScreenGui and window.ScreenGui.AbsoluteSize.Y) or 1080

        -- Placement with screen boundary protection for mobile devices
        local absX = mf.AbsolutePosition.X + mf.AbsoluteSize.X + 8
        if absX + currentWidth > screenW - 10 then
            absX = mf.AbsolutePosition.X - currentWidth - 8
            if absX < 8 then
                -- Mobile or compact viewport: dock inside MainFrame bounds
                absX = math.clamp(mf.AbsolutePosition.X + mf.AbsoluteSize.X - currentWidth - 12, 8, screenW - currentWidth - 8)
            end
        end

        local minY = mf.AbsolutePosition.Y - topInset
        local maxY = mf.AbsolutePosition.Y + mf.AbsoluteSize.Y - topInset

        local preferredHeight = getTargetHeight()
        local maxAllowedHeight = math.max(60, (maxY - minY) - 16)
        local finalHeight = math.min(preferredHeight, maxAllowedHeight)
        local isOverflowing = preferredHeight > finalHeight

        local posY = dropdownCard.AbsolutePosition.Y - topInset
        if posY + finalHeight > maxY - 8 then
            posY = (maxY - 8) - finalHeight
        end
        if posY < minY + 8 then
            posY = minY + 8
        end
        if posY < 8 then
            posY = 8
        end

        return UDim2.new(0, absX, 0, posY), finalHeight, isOverflowing
    end

