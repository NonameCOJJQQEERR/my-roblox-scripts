    local mainScale = Create("UIScale", {
        Name = "MainScale",
        Scale = 1
    })


    self.MainFrame = Create("Frame", {
        Name = "MainFrame",
        Size = UDim2.new(0, 460, 0, 320), -- Reduced for better mobile fit
