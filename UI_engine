    local _, uS = createColorSlider(controlsFrame, "S", satColorGradient, s, function(pct)
        s = pct
        updateColor()
    end)
    updateSat = uS

    local _, uV = createColorSlider(controlsFrame, "V", valColorGradient, v, function(pct)
        v = pct
        updateColor()
