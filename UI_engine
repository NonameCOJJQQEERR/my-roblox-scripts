        TweenService:Create(actionBtnFrame, TweenInfo.new(0.15), { BackgroundColor3 = hoverBg }):Play()
        TweenService:Create(btnText, TweenInfo.new(0.15), { TextColor3 = self.Window.Theme.Text }):Play()
