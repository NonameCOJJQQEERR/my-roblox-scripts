        Size = UDim2.new(1, -150, 1, -66),
        Position = UDim2.new(0, 150, 0, 40),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Active = true, -- Block click-through on MainContainer
        Parent = self.MainFrame
    })

    -- Bottom Status Bar
    self.Bottombar = Create("Frame", {
        Name = "Bottombar",
        Size = UDim2.new(1, 0, 0, 26),
        Position = UDim2.new(0, 0, 1, -26),
        BackgroundTransparency = 1, -- Fully transparent to let MainFrame glass show
        BorderSizePixel = 0,
        Active = true, -- Block click-through on Bottombar
        Parent = self.MainFrame
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 10) }),
        -- Flat corner patch for bottom left and right corner roundings inside
        Create("Frame", {
            Size = UDim2.new(1, 0, 0, 8),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1, -- Transparent patch
            BorderSizePixel = 0
        }),
        -- Top boundary line
        Create("Frame", {
            Size = UDim2.new(1, 0, 0, 1),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = self.Theme.Border,
            BackgroundTransparency = self.Theme.BorderTransparency or 0.3,
            BorderSizePixel = 0
        }),
        -- Status dot + UI version label (using RichText)
        Create("TextLabel", {
            Name = "StatusLabel",
            Text = '<font color="#10b981">в—Џ</font>  ' .. string.upper(self.Title or "VALINC QUARTZ") .. ' ' .. string.upper(self.Subtitle or "V7.0.0"),
            RichText = true,
            Font = Enum.Font.GothamBold,
            TextSize = 8,
            TextColor3 = self.Theme.MutedText,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ClipsDescendants = true,
            Size = UDim2.new(1, -165, 1, 0),
            Position = UDim2.new(0, 15, 0, 0),
            BackgroundTransparency = 1
        }),
        -- Copyright / Branding label
        Create("TextLabel", {
            Name = "BrandingLabel",
            Text = "VALINC QUARTZ UI В© 2026",
            Font = Enum.Font.GothamMedium,
            TextSize = 8,
            TextColor3 = self.Theme.MutedText,
            TextTransparency = 0.3,
            TextXAlignment = Enum.TextXAlignment.Right,
            Size = UDim2.new(0.5, 0, 1, 0),
            Position = UDim2.new(0.5, -28, 0, 0), -- clear of the bottom-right resize grip
            BackgroundTransparency = 1
        })
    })

    -- Notifications Layer
    self.NotifyContainer = Create("Frame", {
        Name = "NotifyContainer",
        Size = UDim2.new(0, 260, 1, -40),
        Position = UDim2.new(1, -280, 0, 20),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 10,
        Parent = self.ScreenGui
    }, {
        Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            HorizontalAlignment = Enum.HorizontalAlignment.Right
        })
    })

    -- ------------------------------------------------------------------
    -- Resize Handle (bottom-right corner grip)
    -- The button keeps an invisible 20x20 hit area; inside it three diagonal
    -- hairlines form the classic resize grip so the affordance is visible
    -- instead of a blank transparent square.
    -- ------------------------------------------------------------------
    resizeHandle = Create("ImageButton", {
        Name = "ResizeHandle",
        Position = UDim2.new(1, -24, 1, -24),
        Size = UDim2.new(0, 20, 0, 20),
        BackgroundTransparency = 1,
        Image = "",
        AutoButtonColor = false,
        Active = true,
        ZIndex = 200,
        Parent = self.MainFrame
    })

    local gripLines = {}
    for i, spec in ipairs({ { 8, 16 }, { 5, 12 }, { 3, 8 } }) do
        gripLines[i] = Create("Frame", {
            Name = "GripLine" .. tostring(i),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, spec[2], 0, spec[2]),
            Size = UDim2.new(0, spec[1], 0, 2),
            Rotation = -45,
            BackgroundColor3 = self.Theme.MutedText,
            BackgroundTransparency = 0.35,
            BorderSizePixel = 0,
            ZIndex = 201,
            Parent = resizeHandle
        })
    end

    local function setGripHighlight(highlighted)
        local color = highlighted and self.Accent or self.Theme.MutedText
        local transparency = highlighted and 0 or 0.35
        for _, line in ipairs(gripLines) do
            TweenService:Create(line, TweenInfo.new(0.15), {
                BackgroundColor3 = color,
                BackgroundTransparency = transparency
            }):Play()
        end
    end

    self:BindConnection(resizeHandle.MouseEnter:Connect(function() setGripHighlight(true) end))
    self:BindConnection(resizeHandle.MouseLeave:Connect(function() setGripHighlight(false) end))
    self:BindConnection(resizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then setGripHighlight(true) end
    end))
    self:BindConnection(resizeHandle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then setGripHighlight(false) end
    end))

    AddDescriptionHint(resizeHandle, self, "Drag this corner to resize the window")

    local resizing = false
    local initialInputPos
    local initialWindowSize
    local initialWindowPos
    local initialTopLeft

    local activeResizeInput = nil
    local connResize1 = resizeHandle.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not resizing then
            resizing = true
            activeResizeInput = input
            initialInputPos = input.Position
            -- Size offsets (not AbsoluteSize) are the values we write back on every
            -- frame, so the drag math stays in the same coordinate space.
            initialWindowSize = Vector2.new(self.MainFrame.Size.X.Offset, self.MainFrame.Size.Y.Offset)
            initialWindowPos = self.MainFrame.Position
            initialTopLeft = Vector2.new(self.MainFrame.AbsolutePosition.X, self.MainFrame.AbsolutePosition.Y)
        end
    end)

    local connResize2 = UserInputService.InputChanged:Connect(function(input)
        if resizing then
            local isMouseDrag = (activeResizeInput and activeResizeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
            local isTouchDrag = (activeResizeInput and input == activeResizeInput and input.UserInputType == Enum.UserInputType.Touch)
            if isMouseDrag or isTouchDrag then
                if not initialInputPos or not initialWindowSize or not initialWindowPos or not initialTopLeft then return end

                -- Screen pixels -> UI offsets (MainScale is 1 today, kept future-proof).
                local uiScale = (mainScale and mainScale.Scale) or 1
                if uiScale <= 0 then uiScale = 1 end
                local delta = (input.Position - initialInputPos) / uiScale

                local screenW, screenH = 1920, 1080
                pcall(function()
                    if self.ScreenGui then
                        screenW = self.ScreenGui.AbsoluteSize.X
                        screenH = self.ScreenGui.AbsoluteSize.Y
                    end
                end)

                -- Cap growth against the remaining screen area. The top-left stays
                -- pinned, so clamping the SIZE (never the position) is what keeps
                -- the window on screen without the left edge sliding.
                local maxW = math.max(MIN_WINDOW_W, math.min(MAX_WINDOW_W, screenW - initialTopLeft.X - 8))
                local maxH = math.max(MIN_WINDOW_H, math.min(MAX_WINDOW_H, screenH - initialTopLeft.Y - 8))

                local newWidth = math.clamp(initialWindowSize.X + delta.X, MIN_WINDOW_W, maxW)
                local newHeight = math.clamp(initialWindowSize.Y + delta.Y, MIN_WINDOW_H, maxH)

                self.MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)

                -- AnchorPoint is (0.5, 0.5), so shifting Position by half of the
                -- ACTUAL delta pins the top-left corner: the frame grows toward
                -- the bottom-right instead of swelling around its centre.
                local actualDeltaX = newWidth - initialWindowSize.X
                local actualDeltaY = newHeight - initialWindowSize.Y

                self.MainFrame.Position = UDim2.new(
                    initialWindowPos.X.Scale,
                    initialWindowPos.X.Offset + (actualDeltaX / 2),
                    initialWindowPos.Y.Scale,
                    initialWindowPos.Y.Offset + (actualDeltaY / 2)
                )
            end
        end
    end)

    local connResize3 = UserInputService.InputEnded:Connect(function(input)
        if resizing then
            local isMouseEnd = (activeResizeInput and activeResizeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
            local isTouchEnd = (activeResizeInput and input == activeResizeInput and input.UserInputType == Enum.UserInputType.Touch)
            if isMouseEnd or isTouchEnd then
                resizing = false
                activeResizeInput = nil
            end
        end
    end)

    self:BindConnection(connResize1)
    self:BindConnection(connResize2)
    self:BindConnection(connResize3)

    self:BindConnection(UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == self.ToggleKey then
            if minimized then
                restoreWindow(true)
            else
                self.Visible = not self.Visible
                self.MainFrame.Visible = self.Visible
                if not self.Visible then
                    floatingWidget.Visible = true
                    if self.ActiveDropdown then self.ActiveDropdown:Close() end
                else
                    floatingWidget.Visible = false
                end
            end
        end
    end))

    if self.AutoLoad then
        task.defer(function()
            local cfg = (type(self.AutoLoad) == "string" and self.AutoLoad) or "Default"
            pcall(function() self:LoadConfig(cfg, true) end)
        end)
    end

    return self
end

-- Bind a connection to self.Connections for automatic cleanup on Destroy
function ValincUi:BindConnection(conn)
    if not self.Connections then self.Connections = {} end
    if typeof(conn) == "RBXScriptConnection" then
        table.insert(self.Connections, conn)
    end
    return conn
end

-- Destroy UI Cleanly & Full Garbage Collection Cleanup
function ValincUi:Destroy()
    if self._Destroyed then return end
    self._Destroyed = true

    if type(self.OnClose) == "function" then
        pcall(self.OnClose)
        self.OnClose = nil
    end

    -- Close active dropdown if open
    if self.ActiveDropdown and typeof(self.ActiveDropdown.Close) == "function" then
        pcall(function() self.ActiveDropdown:Close() end)
        self.ActiveDropdown = nil
    end

    -- 1. Disconnect active watermark if present
    if self.ActiveWatermark then
        pcall(function() self.ActiveWatermark:Destroy() end)
        self.ActiveWatermark = nil
    end

    -- 3. Disconnect all registered RBXScriptConnections
    if self.Connections then
        for _, conn in ipairs(self.Connections) do
            if typeof(conn) == "RBXScriptConnection" and conn.Connected then
                pcall(function() conn:Disconnect() end)
            end
        end
        self.Connections = {}
    end

    -- 4. Destroy ScreenGui
    if self.ScreenGui then
        GetLiveWindowRegistry()[self.ScreenGui] = nil
        pcall(function() self.ScreenGui:Destroy() end)
        self.ScreenGui = nil
    end

    -- 5. Release heavy state: referensi window yang masih dipegang user script
    -- tidak boleh menahan graf widget + closure callback di memori.
    self.ActiveTab = nil
    self.Tabs = nil
    self.Categories = nil
    self.ConfigRegistry = nil
    self.NotifyContainer = nil
    self.FloatingMinWidget = nil
    self.MainFrame = nil
    self.Sidebar = nil
    self.TabList = nil
end

-- Live Hot-Reload UI Feature (Updates UI live in-game without leaving the server)
function ValincUi.Reload(targetUrl, callback)
    if not targetUrl or targetUrl == "" then
        warn("[ValincUi] HotReload failed: Target script URL required.")
        return nil
    end
    
    -- Clean up any active ScreenGui instance
    local parent = resolveParent()
    if parent then
        ValincUi.SweepStaleWindows(parent, nil)
    end
    
    local success, rawCode = pcall(game.HttpGet, game, targetUrl)
    if success and rawCode and #rawCode > 0 then
        local compiled, err = loadstring(rawCode)
        if compiled then
            local newLib = compiled()
            if type(callback) == "function" then
                task.spawn(callback, newLib)
            end
            return newLib
        else
            warn("[ValincUi] Hot-reload compile error:", err)
        end
    else
        warn("[ValincUi] Hot-reload HttpGet failed for URL:", targetUrl)
    end
    return nil
end

function ValincUi:HotReload(targetUrl, callback)
    targetUrl = targetUrl or self.CdnUrl
    self:Destroy()
    return ValincUi.Reload(targetUrl, callback)
end

-- Apply Theme dynamically using recursive descendant walk
function ValincUi:ApplyTheme(themeName)
    local newTheme = Themes[themeName]
    if not newTheme then return end
    
    local oldTheme = self.Theme
    self.Theme = newTheme
    
    local function tween(inst, properties)
        TweenService:Create(inst, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties):Play()
    end
    
    local function colorMatch(c1, c2)
        if not c1 or not c2 or not c1.R or not c2.R then return false end
        return math.abs(c1.R - c2.R) < 0.02 and math.abs(c1.G - c2.G) < 0.02 and math.abs(c1.B - c2.B) < 0.02
    end

    if self.MainFrame then
        tween(self.MainFrame, { 
            BackgroundColor3 = newTheme.Background,
            BackgroundTransparency = newTheme.BackgroundTransparency or 0 
        })
        local stroke = self.MainFrame:FindFirstChildOfClass("UIStroke")
        if stroke then 
            tween(stroke, { 
                Color = newTheme.Border, 
                Transparency = newTheme.BorderTransparency or 0.3 
            }) 
        end
    end
    if self.Sidebar then
        local stroke = self.Sidebar:FindFirstChild("Border") or self.Sidebar:FindFirstChildOfClass("UIStroke")
        if stroke then 
            tween(stroke, { 
                Color = newTheme.Border, 
                Transparency = newTheme.BorderTransparency or 0.3 
            }) 
        end
    end
    if self.Bottombar then
        local label = self.Bottombar:FindFirstChildOfClass("TextLabel")
        if label then tween(label, { TextColor3 = newTheme.MutedText }) end
        -- Update separator lines in Bottombar
        for _, child in ipairs(self.Bottombar:GetChildren()) do
            if child:IsA("Frame") and child.Size.Y.Offset == 1 then
                tween(child, { 
                    BackgroundColor3 = newTheme.Border,
                    BackgroundTransparency = newTheme.BorderTransparency or 0.3
                })
            end
        end
    end
    if self.Topbar then
        -- Update separator lines in Topbar
        for _, child in ipairs(self.Topbar:GetChildren()) do
            if child:IsA("Frame") and child.Size.Y.Offset == 1 then
                tween(child, { 
                    BackgroundColor3 = newTheme.Border,
                    BackgroundTransparency = newTheme.BorderTransparency or 0.3
                })
            end
        end
    end
    -- FloatingMinWidget is a pure transparent logo image button, no background colors or stroke updates needed.

    for _, desc in ipairs(self.ScreenGui:GetDescendants()) do
        if desc:IsA("Frame") or desc:IsA("ScrollingFrame") or desc:IsA("TextBox") then
            if desc.Name:find("DropdownPanel_") or desc.Name:find("MultiDropdownPanel_") or desc.Name:find("Section") or desc.Name:find("Notification") or desc.Name == "SettingsPopup" then
                local isMenu = desc.Name:find("DropdownPanel_") or desc.Name:find("MultiDropdownPanel_")
                tween(desc, { 
                    BackgroundColor3 = isMenu and (newTheme.MenuBackground or Color3.fromRGB(22, 22, 26)) or newTheme.Card,
                    BackgroundTransparency = isMenu and (newTheme.MenuBackgroundTransparency or 0) or (newTheme.CardTransparency or 0)
                })
            elseif desc.Name:find("Card") then
                -- Standalone cards vs nested cards in sections
                local isStandalone = (desc.Parent and (desc.Parent:IsA("ScrollingFrame") or string.find(desc.Parent.Name, "Page$")))
                local targetTrans = isStandalone and (newTheme.CardTransparency or 0) or 1
                tween(desc, { 
                    BackgroundColor3 = newTheme.Card,
                    BackgroundTransparency = targetTrans 
                })
            elseif desc.Name == "OptionsContainer" then
                tween(desc, { 
                    BackgroundTransparency = 1 -- Always transparent, parent menu frame provides background
                })
            elseif desc.Name == "SearchBox" or desc.Name == "InputField" then
                local bgTrans = (desc.Name == "InputField") and 1 or 0.4
                local bgCol = (desc.Name == "InputField") and newTheme.WidgetBackground or newTheme.InputBackground
                tween(desc, {
                    BackgroundColor3 = bgCol,
                    BackgroundTransparency = bgTrans,
                    TextColor3 = newTheme.Text,
                    PlaceholderColor3 = newTheme.MutedText
                })
            elseif desc.Name == "ActionBtnFrame" or desc.Name == "ExecBtnFrame" or desc.Name == "InputBox" or desc.Name == "SelectorBox" or desc.Name == "CensorBadge" or desc.Name == "StepperBox" then
                tween(desc, { BackgroundColor3 = newTheme.WidgetBackground })
            elseif desc.Name == "AutoBtnFrame" then
                if colorMatch(desc.BackgroundColor3, oldTheme.Accent) or colorMatch(desc.BackgroundColor3, newTheme.Accent) then
                    tween(desc, { BackgroundColor3 = newTheme.Accent })
                else
                    tween(desc, { BackgroundColor3 = newTheme.WidgetBackground })
                end
            elseif desc.Name == "BarFill" then
                tween(desc, { BackgroundColor3 = newTheme.Accent })
            elseif desc.Name == "BarTrack" then
                tween(desc, { BackgroundColor3 = newTheme.WidgetHover })
            elseif desc.Name == "Track" or desc.Name == "ThemeTrack" or desc.Name == "CensorTrack" then
                if not colorMatch(desc.BackgroundColor3, oldTheme.Accent) and not colorMatch(desc.BackgroundColor3, newTheme.Accent) then
                    tween(desc, { BackgroundColor3 = newTheme.InputBackground })
                end
            elseif desc.Name == "Knob" or desc.Name == "ThemeKnob" or desc.Name == "CensorKnob" then
                local knobColor = (themeName == "Dark") and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(255, 255, 255)
                tween(desc, { BackgroundColor3 = knobColor })
            elseif desc.Name:find("GripLine") then
                -- Resize grip hairlines: recolor, but leave an accent-highlighted
                -- grip alone until the pointer leaves it.
                if not colorMatch(desc.BackgroundColor3, oldTheme.Accent) and not colorMatch(desc.BackgroundColor3, newTheme.Accent) then
                    tween(desc, { BackgroundColor3 = newTheme.MutedText })
                end
            elseif desc.Size.X.Offset == 1 or desc.Size.Y.Offset == 1 then
                -- Dynamically update 1px border lines and sidebar separators
                tween(desc, { 
                    BackgroundColor3 = newTheme.Border,
                    BackgroundTransparency = newTheme.BorderTransparency or 0.3
                })
            end
        elseif desc:IsA("UIStroke") then
            if desc.Name == "AutoStroke" or desc.Name == "ExecStroke" then
                if colorMatch(desc.Color, oldTheme.Accent) or colorMatch(desc.Color, newTheme.Accent) then
                    tween(desc, { Color = newTheme.Accent, Transparency = 0 })
                else
                    tween(desc, { Color = newTheme.Border, Transparency = newTheme.WidgetBorderTransparency or 0.85 })
                end
            elseif desc.Name == "KnobStroke" then
                tween(desc, { Color = newTheme.Accent })
            elseif not colorMatch(desc.Color, oldTheme.Accent) and not colorMatch(desc.Color, newTheme.Accent) then
                local isCardStroke = desc.Parent and desc.Parent.Name:find("Card")
                local isSectionStroke = desc.Parent and desc.Parent.Name:find("Section")
                local isWidgetStroke = desc.Parent and (desc.Parent.Name == "SelectorBox" or desc.Parent.Name == "InputBox" or desc.Parent.Name == "ActionBtnFrame" or desc.Parent.Name == "OptionsContainer" or desc.Parent.Name == "BindBtn" or desc.Parent.Name == "Preview" or desc.Parent.Name == "StepperBox")
                local targetTrans = isWidgetStroke and (newTheme.WidgetBorderTransparency or 0.85) or ((isCardStroke or isSectionStroke) and (newTheme.CardBorderTransparency or 0.92) or (newTheme.BorderTransparency or 0.88))
                
                -- Disable stroke for nested row containers inside sections
                if isCardStroke and desc.Parent.Parent and not (desc.Parent.Parent:IsA("ScrollingFrame") or string.find(desc.Parent.Parent.Name, "Page$")) then
                    tween(desc, { Transparency = 1 })
                else
                    tween(desc, { 
                        Color = newTheme.Border, 
                        Transparency = targetTrans 
                    })
                end
            end
        elseif desc:IsA("TextLabel") or desc:IsA("TextBox") then
            if desc.Name ~= "StatusLabel" then
                if colorMatch(desc.TextColor3, oldTheme.Text) then
                    tween(desc, { TextColor3 = newTheme.Text })
                elseif colorMatch(desc.TextColor3, oldTheme.MutedText) or desc.Name:find("Subtitle") then
                    tween(desc, { TextColor3 = newTheme.MutedText })
                end
                -- Dynamically update background of opaque text labels (dotted line masks) to Card color
                if desc.BackgroundTransparency < 1 then
                    tween(desc, { 
                        BackgroundColor3 = newTheme.Card,
                        BackgroundTransparency = newTheme.CardTransparency or 0
                    })
                end
            end
        elseif desc:IsA("TextButton") then
            if desc.Name == "CancelBtn" then
                local btnBg = themeName == "Dark" and newTheme.Card or Color3.fromRGB(240, 240, 245)
                local btnTrans = themeName == "Dark" and 0.5 or 0
                tween(desc, {
                    BackgroundColor3 = btnBg,
                    BackgroundTransparency = btnTrans,
                    TextColor3 = newTheme.MutedText
                })
            elseif desc.Name == "BindBtn" then
                local darkBg = themeName == "Dark" and Color3.fromRGB(30, 30, 38) or Color3.fromRGB(240, 240, 245)
                tween(desc, { BackgroundColor3 = darkBg })
                if colorMatch(desc.TextColor3, oldTheme.Text) then
                    tween(desc, { TextColor3 = newTheme.Text })
                elseif colorMatch(desc.TextColor3, oldTheme.MutedText) then
                    tween(desc, { TextColor3 = newTheme.MutedText })
                end
            elseif desc.Name == "TabButton" then
                if not desc:FindFirstChild("Indicator") or desc.Indicator.BackgroundTransparency == 1 then
                    tween(desc, { TextColor3 = newTheme.MutedText })
                else
                    tween(desc, { TextColor3 = newTheme.Text })
                end
            elseif desc.Parent and desc.Parent.Name == "OptionsContainer" then
                if colorMatch(desc.TextColor3, oldTheme.MutedText) then
                    tween(desc, { TextColor3 = newTheme.MutedText })
                elseif colorMatch(desc.TextColor3, oldTheme.Text) then
                    tween(desc, { TextColor3 = newTheme.Text })
                end
            else
                if colorMatch(desc.TextColor3, oldTheme.Text) then
                    tween(desc, { TextColor3 = newTheme.Text })
                elseif colorMatch(desc.TextColor3, oldTheme.MutedText) then
                    tween(desc, { TextColor3 = newTheme.MutedText })
                end
            end
        elseif desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
            -- Protect user profile Avatar and custom logos from becoming a black silhouette
            if desc.Name == "SectionIcon" then
                tween(desc, { ImageColor3 = newTheme.Accent })
            elseif desc.Name ~= "Avatar" and desc.Name ~= "LogoLabel" and desc.Name ~= "Logo" then
                if colorMatch(desc.ImageColor3, oldTheme.MutedText) then
                    tween(desc, { ImageColor3 = newTheme.MutedText })
                elseif colorMatch(desc.ImageColor3, oldTheme.Text) then
                    tween(desc, { ImageColor3 = newTheme.Text })
                elseif colorMatch(desc.ImageColor3, oldTheme.Accent) then
                    tween(desc, { ImageColor3 = newTheme.Accent })
                end
            elseif desc.Name == "LogoLabel" or desc.Name == "Logo" then
                -- Always keep custom logos untinted (white / no tint)
                tween(desc, { ImageColor3 = Color3.fromRGB(255, 255, 255) })
            end
        end
    end
end

-- Interactive Modal Dialog / Confirmation Prompt component
function ValincUi:Dialog(options)
    options = options or {}
    local title = options.Title or "Confirmation"
    local content = options.Content or options.Text or "Are you sure you want to proceed?"
    local buttons = options.Buttons or {
        { Text = "Confirm", Style = "Primary", Callback = options.OnConfirm },
        { Text = "Cancel", Style = "Secondary", Callback = options.OnCancel }
    }

    local targetParent = self.ScreenGui
    if not targetParent then return end

    -- Dim backdrop overlay
    local modalOverlay = Create("Frame", {
        Name = "ModalOverlay",
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Active = true,
        ZIndex = 400,
        Parent = targetParent
    })

    -- Dialog card centered on screen
    local dialogCard = Create("Frame", {
        Name = "DialogCard",
        Size = UDim2.new(0, 320, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = self.Theme.Card,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 401,
        Parent = modalOverlay
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
        Create("UIStroke", {
            Thickness = 1,
            Color = self.Theme.Border,
            Transparency = self.Theme.CardBorderTransparency or 0.4,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        }),
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 14),
            PaddingBottom = UDim.new(0, 14),
            PaddingLeft = UDim.new(0, 16),
            PaddingRight = UDim.new(0, 16)
        }),
        Create("UIListLayout", {
            Padding = UDim.new(0, 10),
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder
        })
    })

    -- Title
