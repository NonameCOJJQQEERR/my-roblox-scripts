    local function createColorSlider(parent, labelText, bgGradient, initPercent, onDrag)
        local container = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Parent = parent
        }, {
            Create("TextLabel", {
